@model PIM_WebApplication.ViewModels.RegistroViewModel
@{
    ViewData["Title"] = "Cadastrar Conta";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-wrapper">
    <div class="auth-visual auth-visual-register">
        <div class="auth-visual-emoji"></div>
        <div class="auth-visual-title">Crie sua conta</div>
        <p>Junte-se a milhares de compradores e aproveite ofertas exclusivas todos os dias.</p>
    </div>

    <div class="auth-form-area">
        <div class="auth-card">
            <h2>Cadastrar</h2>
            <p class="subtitle">Crie sua conta gratuitamente</p>

            <form asp-controller="Conta" asp-action="Registrar" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="field">
                    <label asp-for="Nome"></label>
                    <input asp-for="Nome" placeholder="João da Silva" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>

                <div class="field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" placeholder="seu@email.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="field">
                    <label asp-for="Telefone"></label>
                    <input asp-for="Telefone" placeholder="(62) 99999-9999" />
                    <span asp-validation-for="Telefone" class="text-danger"></span>
                </div>

                <div class="field">
                    <label asp-for="Senha"></label>
                    <input asp-for="Senha" placeholder="Mínimo 6 caracteres" />
                    <span asp-validation-for="Senha" class="text-danger"></span>
                </div>

                <div class="field">
                    <label asp-for="ConfirmarSenha"></label>
                    <input asp-for="ConfirmarSenha" placeholder="Repita a senha" />
                    <span asp-validation-for="ConfirmarSenha" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-primary">Criar conta</button>
            </form>

            <p class="auth-switch" style="margin-top: 1.5rem;">
                Já tem conta? <a asp-controller="Conta" asp-action="Login">Fazer login</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
