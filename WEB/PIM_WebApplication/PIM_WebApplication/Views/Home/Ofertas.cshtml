@model PIM_WebApplication.ViewModels.OfertasViewModel
@{
    ViewData["Title"] = "Ofertas e Vantagens Exclusivas";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ofertas.css" asp-append-version="true" />
}

<div class="oferta-banner">
    <div class="oferta-banner-bg">
        <div class="oferta-banner-particle" style="--x:10%;--y:20%;--s:80px;--d:0s"></div>
        <div class="oferta-banner-particle" style="--x:80%;--y:60%;--s:120px;--d:1s"></div>
        <div class="oferta-banner-particle" style="--x:50%;--y:80%;--s:60px;--d:0.5s"></div>
        <div class="oferta-banner-particle" style="--x:90%;--y:10%;--s:100px;--d:1.5s"></div>
    </div>

    <div class="oferta-banner-content">
        <div class="oferta-tag-anim">VANTAGENS EXCLUSIVAS</div>
        <h1 class="oferta-banner-title">
            FRETE GRÁTIS<br />
            <span>acima de R$ 800,00</span>
        </h1>
        <ul class="oferta-banner-lista">
            <li>Frete grátis em todos os pedidos acima de R$ 800,00 para todo o Brasil</li>
            <li>Taxa fixa de envio de apenas R$ 9,99 para compras abaixo de R$ 800,00</li>
            <li>Cupons adicionais exclusivos com utilização única por cliente</li>
            <li>Instrumentos revisados com procedência e garantia total de loja</li>
        </ul>
        <div class="oferta-banner-btn-area">
            <a href="#catalogo-ofertas" class="btn-ofertas-banner">Ver instrumentos em destaque</a>
        </div>
    </div>
</div>

<div id="catalogo-ofertas" class="section section-center" style="padding-top: 1.5rem;">
    <div class="ofertas-section-header">
        <h2>Instrumentos e Acessórios em Destaque</h2>
        <p>Aproveite frete grátis para compras acima de R$ 800,00 e aplique seus cupons de desconto no carrinho!</p>
    </div>

    <div class="products-grid">
        @if (Model.Produtos.Any())
        {
            @foreach (var produto in Model.Produtos)
            {
                var estoqueDisponivel = produto.Estoque?.QuantidadeDisponivel ?? 0;
                var temEstoque = estoqueDisponivel > 0;
                
                string fallback = "/img/outros.png";
                var catLower = (produto.TipoInstrumento ?? "").ToLowerInvariant();
                if (catLower.Contains("guitar")) fallback = "/img/guitarra.jpeg";
                else if (catLower.Contains("viol")) fallback = "/img/violao.png";
                else if (catLower.Contains("teclad") || catLower.Contains("piano") || catLower.Contains("sintetiz")) fallback = "/img/teclado.png";
                else if (catLower.Contains("bater")) fallback = "/img/bateria.jpeg";
                else if (catLower.Contains("acess") || catLower.Contains("palhet") || catLower.Contains("cabo") || catLower.Contains("afinador") || catLower.Contains("correia")) fallback = "/img/acessorios.png";
                else fallback = "/img/outros.png";

                var imagemFinal = !string.IsNullOrWhiteSpace(produto.ImagemUrl) ? produto.ImagemUrl : fallback;
                var descricaoProduto = !string.IsNullOrWhiteSpace(produto.Descricao) 
                    ? produto.Descricao 
                    : "Instrumento musical em destaque com excelente timbre, acabamento selecionado e garantia total de loja.";

                <div class="product-card"
                     data-id="@produto.IdProduto"
                     data-nome="@produto.Modelo"
                     data-categoria="@produto.TipoInstrumento"
                     data-preco="@produto.Preco.ToString("N2", new System.Globalization.CultureInfo("pt-BR"))"
                     data-preco-raw="@produto.Preco.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                     data-descricao="@descricaoProduto"
                     data-estoque="@estoqueDisponivel"
                     data-imagem="@imagemFinal"
                     onclick="abrirModalDetalhesPorCard(this, event)">

                    <div class="product-img">
                        <img src="@imagemFinal" alt="@produto.Modelo" onerror="this.onerror=null;this.src='@fallback';" />
                    </div>
                    <div class="product-info">
                        <div class="product-name">@produto.Modelo</div>
                        <div class="product-desc">Categoria: @produto.TipoInstrumento &middot; Estoque: @estoqueDisponivel un</div>
                        <div class="product-footer">
                            <span class="product-price">R$ @produto.Preco.ToString("N2", new System.Globalization.CultureInfo("pt-BR"))</span>
                            <form asp-controller="Carrinho" asp-action="Adicionar" method="post" style="display:inline;" onclick="event.stopPropagation();">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idProduto" value="@produto.IdProduto" />
                                <input type="hidden" name="nome" value="@produto.TipoInstrumento" />
                                <input type="hidden" name="preco" value="@produto.Preco.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                <input type="hidden" name="modelo" value="@produto.Modelo" />
                                <input type="hidden" name="tamanho" value="@produto.Modelo" />
                                <input type="hidden" name="imagemUrl" value="@imagemFinal" />
                                <button type="submit" class="add-btn" title="Adicionar ao carrinho" @(!temEstoque ? "disabled style='opacity:0.5;cursor:not-allowed;'" : "")>
                                    @(temEstoque ? "+ Adicionar" : "Fora de estoque")
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <p style="grid-column: 1 / -1; color: var(--muted); text-align: center; padding: 2rem;">
                Nenhum instrumento em oferta no momento.
            </p>
        }
    </div>
</div>
