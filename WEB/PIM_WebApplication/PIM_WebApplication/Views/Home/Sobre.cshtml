@{
    ViewData["Title"] = "Sobre Nós";
}

@section Styles {
    <link rel="stylesheet" href="~/css/sobre.css" asp-append-version="true" />
}

<div class="sobre-hero">
    <div class="sobre-hero-content">
        <div class="sobre-tag">Sobre nós</div>
        <h1>Feito por devs,<br /><span>para devs.</span></h1>
        <p>A ShopNow nasceu da vontade de unir tecnologia e moda. Somos uma loja criada por estudantes de ADS apaixonados por código e estilo.</p>
    </div>
    <div class="sobre-hero-emoji">👨‍💻</div>
</div>

<div class="sobre-section">
    <div class="sobre-cards-row">
        <div class="sobre-card">
            <div class="sobre-card-icon">🎯</div>
            <h3>Nossa Missão</h3>
            <p>Oferecer roupas exclusivas para programadores e entusiastas de tecnologia, combinando moda moderna com identidade do universo dev.</p>
        </div>
        <div class="sobre-card">
            <div class="sobre-card-icon">⚡</div>
            <h3>Nosso Diferencial</h3>
            <p>Peças com temas tecnológicos, design moderno e atendimento 24h via suporte. Porque programador não dorme — e a gente também não.</p>
        </div>
        <div class="sobre-card">
            <div class="sobre-card-icon">👥</div>
            <h3>Nosso Público</h3>
            <p>Desenvolvedores, estudantes de TI e qualquer pessoa que ama tecnologia e quer expressar isso com estilo no dia a dia.</p>
        </div>
    </div>
</div>

<div class="sobre-section">
    <div class="sobre-section-title">
        <h2>Nossa Equipe</h2>
        <p>O time por trás da ShopNow</p>
    </div>
    <div class="equipe-grid">
        <div class="equipe-card">
            <div class="equipe-avatar">👩‍🎨</div>
            <div class="equipe-nome">Kelly</div>
            <div class="equipe-cargo">UI & UX Design</div>
        </div>
        <div class="equipe-card">
            <div class="equipe-avatar">👩‍💻</div>
            <div class="equipe-nome">Helena Neves</div>
            <div class="equipe-cargo">Desenvolvimento Web</div>
        </div>
        <div class="equipe-card">
            <div class="equipe-avatar">🗄️</div>
            <div class="equipe-nome">Rondineli</div>
            <div class="equipe-cargo">Banco de Dados</div>
        </div>
        <div class="equipe-card">
            <div class="equipe-avatar">⚙️</div>
            <div class="equipe-nome">Laura</div>
            <div class="equipe-cargo">Engenharia de Software</div>
        </div>
        <div class="equipe-card">
            <div class="equipe-avatar">🧩</div>
            <div class="equipe-nome">Vinícius Duarte</div>
            <div class="equipe-cargo">Programação Orientada a Objetos com C#</div>
        </div>
        <div class="equipe-card">
            <div class="equipe-avatar">💬</div>
            <div class="equipe-nome">Nicolas Ribeiro</div>
            <div class="equipe-cargo">Libras (AVA)</div>
        </div>
    </div>
</div>

<div class="sobre-section">
    <div class="sobre-contato">
        <div class="sobre-contato-icon">✉️</div>
        <h3>Fale com a gente</h3>
        <p>Dúvidas, sugestões ou parcerias? Nosso suporte está disponível <strong>24 horas</strong>!</p>
        <a href="mailto:shopnow2026@gmail.com" class="btn-contato">shopnow2026@gmail.com</a>
    </div>
</div>

<div class="sobre-pim">
    <div class="sobre-pim-inner">
        <span class="pim-badge">Projeto Acadêmico</span>
        <p>A ShopNow é um projeto de PIM desenvolvido pelo curso de <strong>Análise e Desenvolvimento de Sistemas</strong>. Um estudo prático de desenvolvimento web completo em ASP.NET Core MVC.</p>
    </div>
</div>
