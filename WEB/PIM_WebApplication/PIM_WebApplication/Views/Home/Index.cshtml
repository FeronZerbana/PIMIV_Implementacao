@model PIM_WebApplication.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Loja de Música";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="hero">
    <img src="~/img/fundohero.jpg" alt="Fundo Hero" class="hero-bg" />
    <div class="hero-content">
        <h1>Toda melodia começa com a <span>escolha certa</span>.</h1>
        <p>Trabalhamos com instrumentos selecionados para transformar cada momento criativo em uma experiência única. Venha conhecer nosso espaço e descubra o som que combina com você.</p>
        <div class="hero-btns">
            <a href="#destaques" class="btn-hero">Ver produtos</a>
            <a asp-controller="Home" asp-action="Ofertas" class="btn-outline">Nossas ofertas</a>
        </div>
    </div>
</div>

<div class="section categorias-section">
    <div class="section-center">
        <h2 class="section-title">Categorias de Instrumentos</h2>
        <p class="section-sub">Encontre o instrumento ideal para o seu som</p>
    </div>
    @{
        var instrumentos = new[]
        {
            new { Label = "Guitarras",  Controller = "Produtos", Action = "Guitarras",  Img = "/img/guitarra.jpeg" },
            new { Label = "Violões",    Controller = "Produtos", Action = "Violoes",    Img = "/img/violao.png" },
            new { Label = "Teclados",   Controller = "Produtos", Action = "Teclados",   Img = "/img/teclado.png" },
            new { Label = "Baterias",   Controller = "Produtos", Action = "Baterias",   Img = "/img/bateria.jpeg" },
            new { Label = "Outros",     Controller = "Produtos", Action = "Outros",     Img = "/img/outros.png" },
            new { Label = "Acessórios", Controller = "Produtos", Action = "Acessorios", Img = "/img/acessorios.png" }
        };
    }
    <div class="cats-grid">
        @for (int i = 0; i < instrumentos.Length; i++)
        {
            var inst = instrumentos[i];
            <a asp-controller="@inst.Controller" asp-action="@inst.Action" class="cat-card" style="text-decoration:none;">
                <img class="cat-img" src="@inst.Img" alt="@inst.Label" />
                <div class="cat-name">@inst.Label</div>
            </a>
        }
    </div>
</div>

<div id="destaques" class="section section-center" style="padding-top: 1rem;">
    <h2 class="section-title">Destaques</h2>
    <p class="section-sub">Os instrumentos mais procurados da loja</p>

    <div class="products-grid">
        @if (Model.Destaques.Any())
        {
            @foreach (var produto in Model.Destaques)
            {
                var estoqueDisponivel = produto.Estoque?.QuantidadeDisponivel ?? 0;
                var temEstoque = estoqueDisponivel > 0;

                string fallbackCategoria = "/img/outros.png";
                var catLower = (produto.TipoInstrumento ?? produto.TipoRoupa ?? "").ToLowerInvariant();
                if (catLower.Contains("guitar")) fallbackCategoria = "/img/guitarra.jpeg";
                else if (catLower.Contains("viol")) fallbackCategoria = "/img/violao.png";
                else if (catLower.Contains("teclad") || catLower.Contains("piano") || catLower.Contains("sintetiz")) fallbackCategoria = "/img/teclado.png";
                else if (catLower.Contains("bater")) fallbackCategoria = "/img/bateria.jpeg";
                else if (catLower.Contains("acess") || catLower.Contains("palhet") || catLower.Contains("cabo") || catLower.Contains("afinador") || catLower.Contains("correia")) fallbackCategoria = "/img/acessorios.png";
                else fallbackCategoria = "/img/outros.png";

                var imagemFinal = !string.IsNullOrWhiteSpace(produto.ImagemUrl) ? produto.ImagemUrl : fallbackCategoria;
                var descricaoProduto = !string.IsNullOrWhiteSpace(produto.Descricao)
                    ? produto.Descricao
                    : "Instrumento musical em destaque com excelente timbre, acabamento selecionado e garantia total de loja.";

                <div class="product-card"
                     data-id="@produto.IdProduto"
                     data-nome="@produto.Modelo"
                     data-categoria="@produto.TipoInstrumento"
                     data-preco="@produto.Preco.ToString("N2", new System.Globalization.CultureInfo("pt-BR"))"
                     data-preco-raw="@produto.Preco.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                     data-descricao="@descricaoProduto"
                     data-estoque="@estoqueDisponivel"
                     data-imagem="@imagemFinal"
                     onclick="abrirModalDetalhesPorCard(this, event)">

                    <div class="product-img">
                        <img src="@imagemFinal" alt="@produto.Modelo" onerror="this.onerror=null;this.src='@fallbackCategoria';" />
                    </div>
                    <div class="product-info">
                        <div class="product-name">@produto.Modelo</div>
                        <div class="product-desc">Categoria: @produto.TipoInstrumento &middot; Estoque: @estoqueDisponivel un</div>
                        <div class="product-footer">
                            <span class="product-price">R$ @produto.Preco.ToString("N2", new System.Globalization.CultureInfo("pt-BR"))</span>
                            <form asp-controller="Carrinho" asp-action="Adicionar" method="post" style="display:inline;" onclick="event.stopPropagation();">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idProduto" value="@produto.IdProduto" />
                                <input type="hidden" name="nome" value="@produto.TipoInstrumento" />
                                <input type="hidden" name="preco" value="@produto.Preco.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                <input type="hidden" name="modelo" value="@produto.Modelo" />
                                <input type="hidden" name="tamanho" value="@produto.Modelo" />
                                <input type="hidden" name="imagemUrl" value="@imagemFinal" />
                                <button type="submit" class="add-btn" title="Adicionar ao carrinho" @(!temEstoque ? "disabled style='opacity:0.5;cursor:not-allowed;'" : "")>
                                    @(temEstoque ? "+ Adicionar" : "Fora de estoque")
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <p style="grid-column: 1 / -1; color: var(--muted); text-align: center; padding: 2rem;">
                Nenhum produto cadastrado no momento.
            </p>
        }
    </div>
</div>

<div class="banner">
    <div class="banner-text">
        <h3>Frete grátis para compras acima de R$ 800,00!</h3>
        <p>Válido para todo o Brasil. Aproveite também nossos cupons de desconto exclusivos.</p>
    </div>
    <a asp-controller="Home" asp-action="Ofertas" class="btn-hero">Aproveitar agora</a>
</div>
