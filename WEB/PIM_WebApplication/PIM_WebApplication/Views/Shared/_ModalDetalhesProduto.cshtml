<!-- MODAL DE DETALHES DO PRODUTO -->
<div id="modalDetalhesProduto" class="modal-produto-backdrop" role="dialog" aria-modal="true" aria-labelledby="modalProdutoNome" style="display:none;" onclick="tratarCliqueBackdropModal(event)">
    <div class="modal-produto-container" onclick="event.stopPropagation()">
        <button type="button" class="modal-produto-fechar" onclick="fecharModalDetalhes()" aria-label="Fechar detalhes do produto">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>

        <div class="modal-produto-grid">
            <!-- COLUNA DA IMAGEM -->
            <div class="modal-produto-imagem-area">
                <img id="modalProdutoImg" src="" alt="Imagem do Instrumento" class="modal-produto-img" onerror="this.onerror=null;this.src='/img/guitarra.jpeg';" />
            </div>

            <!-- COLUNA DE INFORMACOES -->
            <div class="modal-produto-conteudo">
                <div class="modal-produto-header">
                    <span id="modalProdutoCategoria" class="modal-produto-categoria">CATEGORIA</span>
                    <h2 id="modalProdutoNome" class="modal-produto-titulo">Nome do Instrumento</h2>
                    <div id="modalProdutoPreco" class="modal-produto-preco">R$ 0,00</div>
                </div>

                <div class="modal-produto-status-row">
                    <span id="modalProdutoEstoqueBadge" class="modal-estoque-badge">Consultando estoque...</span>
                </div>

                <div class="modal-produto-bloco-descricao">
                    <h3 class="modal-descricao-titulo">Descricao do Instrumento</h3>
                    <p id="modalProdutoDescricao" class="modal-produto-descricao">
                        Instrumento selecionado com alta fidelidade sonica e acabamento de nivel profissional.
                    </p>
                </div>

                <!-- FORMULARIO DE COMPRA / ADICAO AO CARRINHO -->
                <form id="formModalCarrinho" asp-controller="Carrinho" asp-action="Adicionar" method="post" class="modal-produto-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="modalInputIdProduto" name="idProduto" value="" />
                    <input type="hidden" id="modalInputNome" name="nome" value="" />
                    <input type="hidden" id="modalInputPreco" name="preco" value="" />
                    <input type="hidden" id="modalInputModelo" name="modelo" value="" />
                    <input type="hidden" id="modalInputTamanho" name="tamanho" value="" />
                    <input type="hidden" id="modalInputImagemUrl" name="imagemUrl" value="" />

                    <div class="modal-produto-acoes">
                        <button type="submit" id="modalBtnAdicionarCarrinho" class="btn-carrinho modal-btn-comprar">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="9" cy="21" r="1"></circle>
                                <circle cx="20" cy="21" r="1"></circle>
                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                            </svg>
                            <span id="modalBtnTexto">Adicionar ao carrinho</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
