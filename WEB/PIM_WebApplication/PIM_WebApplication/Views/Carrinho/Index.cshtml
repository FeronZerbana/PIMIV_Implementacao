@model PIM_WebApplication.ViewModels.CarrinhoViewModel
@{
    ViewData["Title"] = "Meu Carrinho";
}

@section Styles {
    <link rel="stylesheet" href="~/css/carrinho.css" asp-append-version="true" />
}

<div class="cart-page-wrapper">
    <div class="cart-left">
        <div class="cart-header">
            <div>
                <h2 class="cart-title">Seu carrinho</h2>
                <p class="cart-subtitle">Revise seus itens selecionados e conclua o pedido.</p>
            </div>
        </div>

        @if (!Model.Itens.Any())
        {
            <div class="cart-empty">
                <p>Seu carrinho está vazio.</p>
                <a asp-controller="Home" asp-action="Index" class="btn-hero">Explorar produtos</a>
            </div>
        }
        else
        {
            <div class="cart-table-head">
                <span>Produto</span>
                <span>Preço</span>
                <span>Quantidade</span>
                <span>Subtotal</span>
            </div>

            <div id="cart-items-list">
                @foreach (var item in Model.Itens)
                {
                    <div class="cart-item">
                        <div class="cart-item-produto">
                            <div class="cart-item-info">
                                <div class="cart-item-nome">@item.Nome</div>
                                <div class="cart-item-desc">Modelo: @item.Modelo - Saldo: @item.EstoqueDisponivel un</div>
                                <form asp-controller="Carrinho" asp-action="Remover" method="post" style="display:inline;">
                                    <input type="hidden" name="idProduto" value="@item.IdProduto" />
                                    <button type="submit" class="cart-item-remover">Remover</button>
                                </form>
                            </div>
                        </div>

                        <div class="cart-item-preco">
                            R$ @item.Preco.ToString("N2")
                        </div>

                        <div class="cart-item-qty">
                            <form asp-controller="Carrinho" asp-action="AlterarQuantidade" method="post" style="display:inline;">
                                <input type="hidden" name="idProduto" value="@item.IdProduto" />
                                <input type="hidden" name="delta" value="-1" />
                                <button type="submit" class="qty-btn">−</button>
                            </form>

                            <span class="qty-num">@item.Quantidade</span>

                            <form asp-controller="Carrinho" asp-action="AlterarQuantidade" method="post" style="display:inline;">
                                <input type="hidden" name="idProduto" value="@item.IdProduto" />
                                <input type="hidden" name="delta" value="1" />
                                <button type="submit" class="qty-btn" @(item.Quantidade >= item.EstoqueDisponivel ? "disabled style='opacity:0.4;cursor:not-allowed'" : "")>+</button>
                            </form>
                        </div>

                        <div class="cart-item-subtotal">
                            R$ @item.Subtotal.ToString("N2")
                        </div>
                    </div>
                }
            </div>

            <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1.5rem;">
                <div class="cart-coupon" style="flex: 1; min-width: 250px;">
                    <form asp-controller="Carrinho" asp-action="AplicarCupom" method="post" style="display:flex; flex:1; gap:0.8rem;">
                        <input type="text" name="codigoCupom" value="@Model.CupomAplicado" placeholder="Cupom de desconto" />
                        <button type="submit" class="btn-coupon">Aplicar</button>
                    </form>
                </div>

                <div class="cart-coupon" style="flex: 1; min-width: 250px;">
                    <form asp-controller="Carrinho" asp-action="CalcularFrete" method="post" style="display:flex; flex:1; gap:0.8rem;">
                        <input type="text" name="cep" value="@Model.CepDestino" placeholder="CEP (00000-000)" maxlength="9" />
                        <button type="submit" class="btn-coupon">Calcular Frete</button>
                    </form>
                </div>
            </div>

            @if (Model.FreteCalculado)
            {
                <div style="margin-top: 0.8rem; font-size: 0.88rem; color: #93c5fd; background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.25); border-radius: 8px; padding: 0.6rem 0.9rem;">
                    @if (Model.Frete == 0)
                    {
                        <span>Frete Grátis aplicado com sucesso para o CEP @Model.CepDestino!</span>
                    }
                    else
                    {
                        <span>Frete fixo de R$ 9,99 calculado para o CEP @Model.CepDestino. (Compras a partir de R$ 800,00 garantem frete grátis!)</span>
                    }
                </div>
            }
        }

        <a asp-controller="Home" asp-action="Index" class="btn-back" style="margin-top: 1.5rem; display: inline-block;">&larr; Continuar comprando</a>
    </div>

    <div class="cart-right">
        <div class="cart-summary">
            <div class="summary-title">
                Resumo da compra
            </div>

            @if (Model.FreteGratisElegivel)
            {
                <div style="background: rgba(16, 185, 129, 0.15); border: 1px solid #10b981; border-radius: 8px; padding: 0.65rem 0.85rem; margin-bottom: 0.85rem; font-size: 0.85rem; color: #a7f3d0;">
                    <strong>Frete Grátis Ativo:</strong> Seu pedido atingiu o valor de compras acima de R$ 800,00!
                </div>
            }
            else if (Model.Subtotal > 0)
            {
                <div style="background: rgba(124, 58, 237, 0.12); border: 1px solid var(--accent); border-radius: 8px; padding: 0.65rem 0.85rem; margin-bottom: 0.85rem; font-size: 0.82rem; color: #d8b4fe;">
                    Adicione mais <strong>R$ @Model.FaltaParaFreteGratis.ToString("N2")</strong> para garantir <strong>Frete Grátis</strong>!
                </div>
            }

            <div class="summary-row">
                <span>Subtotal (@Model.TotalQuantidade @(Model.TotalQuantidade == 1 ? "produto" : "produtos"))</span>
                <span>R$ @Model.Subtotal.ToString("N2")</span>
            </div>

            @if (Model.DescontoCupom > 0)
            {
                <div class="summary-row" style="color:#34d399; font-size:0.85rem;">
                    <span>&bull; Cupom @Model.CupomAplicado</span>
                    <span>– R$ @Model.DescontoCupom.ToString("N2")</span>
                </div>
            }

            <div class="summary-row">
                <span>Total de Descontos</span>
                <span class="summary-desconto">– R$ @Model.Desconto.ToString("N2")</span>
            </div>

            <div class="summary-row">
                <span>Frete <span class="frete-info" title="Grátis acima de R$ 800,00"></span></span>
                <span class="summary-frete" style="@(Model.Frete == 0 ? "color:#60a5fa;" : "")">
                    @(Model.Frete == 0 ? "Grátis" : $"R$ {Model.Frete:N2}")
                </span>
            </div>

            <div class="summary-divider"></div>

            <div class="summary-total-row">
                <span>Total</span>
                <span class="summary-total-value">R$ @Model.Total.ToString("N2")</span>
            </div>

            <div class="summary-parcelamento">
                @if (Model.Total > 0)
                {
                    <span>em até 4x de R$ @Model.ValorParcela sem juros</span>
                }
            </div>

            @if (Model.Itens.Any())
            {
                <form asp-controller="Carrinho" asp-action="Finalizar" method="post">
                    <button type="submit" class="btn-finalizar">Finalizar compra</button>
                </form>
            }
            else
            {
                <button class="btn-finalizar" disabled style="opacity: 0.5; cursor: not-allowed;">Carrinho Vazio</button>
            }

            <div class="summary-seguro">Ambiente 100% seguro</div>
        </div>

        <div class="cart-benefits">
            <div class="cart-benefits-title">Por que comprar na ShopNow?</div>
            <div class="benefit-item">
                <div>
                    <strong>Frete grátis</strong>
                    <p>Em compras acima de R$ 800,00</p>
                </div>
            </div>
            <div class="benefit-item">
                <div>
                    <strong>Entrega rápida</strong>
                    <p>Taxa fixa reduzida de R$ 9,99 para todo o Brasil</p>
                </div>
            </div>
            <div class="benefit-item">
                <div>
                    <strong>Devolução grátis</strong>
                    <p>Até 7 dias após o recebimento</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="cart-trust-bar">
    <div class="trust-item">
        <div><strong>Compra segura</strong><span>Seus dados protegidos</span></div>
    </div>
    <div class="trust-item">
        <div><strong>Atendimento 24h</strong><span>Suporte para clientes e músicos</span></div>
    </div>
    <div class="trust-item">
        <div><strong>Parcele em até 4x</strong><span>Sem juros no cartão</span></div>
    </div>
    <div class="trust-item">
        <div><strong>Satisfação garantida</strong><span>Qualidade assegurada</span></div>
    </div>
</div>
