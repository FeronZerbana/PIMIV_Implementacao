@model PIM_WebApplication.ViewModels.AdminViewModel
@{
    ViewData["Title"] = "Painel Administrativo";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="admin-wrapper">
    <div class="admin-header">
        <div>
            <h1 class="admin-title">Painel Administrativo</h1>
            <p class="admin-subtitle">Gestão de catálogo de instrumentos musicais, estoques e cupons de desconto.</p>
        </div>
    </div>

    @if (TempData["MensagemToast"] != null)
    {
        <div style="background: rgba(124, 58, 237, 0.15); border: 1px solid var(--accent); color: var(--text-heading); padding: 1rem 1.25rem; border-radius: 8px; margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: space-between; font-weight: 500;">
            <span>@TempData["MensagemToast"]</span>
            <button type="button" onclick="this.parentElement.remove()" style="background: none; border: none; color: var(--muted); cursor: pointer; font-size: 1.2rem; line-height: 1;">&times;</button>
        </div>
    }

    <!-- CARD 1: Cadastrar Novo Produto -->
    <div class="admin-card">
        <div class="admin-card-header">
            <div>
                <h2 class="admin-card-titulo">Cadastrar Novo Produto</h2>
                <p class="admin-card-sub">Adicione um novo produto ao catálogo da loja com estoque e descrição</p>
            </div>
        </div>

        <form asp-controller="Admin" asp-action="CadastrarProduto" method="post" enctype="multipart/form-data" class="admin-form">
            @Html.AntiForgeryToken()

            <div class="admin-form-row">
                <div class="admin-field">
                    <label asp-for="NovoProduto.Nome" class="admin-label">Categoria do Produto</label>
                    <select asp-for="NovoProduto.Nome" id="instrumentCategory" class="admin-select" required>
                        <option value="" disabled selected>Selecione uma categoria oficial</option>
                        <option value="Guitarras">Guitarras</option>
                        <option value="Violões">Violões</option>
                        <option value="Teclados">Teclados</option>
                        <option value="Baterias">Baterias</option>
                        <option value="Outros">Outros</option>
                        <option value="Acessórios">Acessórios</option>
                    </select>
                    <span asp-validation-for="NovoProduto.Nome" class="text-danger"></span>
                </div>

                <div class="admin-field">
                    <label asp-for="NovoProduto.Modelo" class="admin-label">Modelo / Especificação</label>
                    <input asp-for="NovoProduto.Modelo" class="admin-input" required />
                    <span asp-validation-for="NovoProduto.Modelo" class="text-danger"></span>
                </div>
            </div>

            <div class="admin-form-row">
                <div class="admin-field">
                    <label asp-for="NovoProduto.Preco" class="admin-label">Preço Unitário (R$)</label>
                    <input asp-for="NovoProduto.Preco" type="number" step="0.01" min="0.01" class="admin-input" placeholder="Ex: 2499.90" required />
                    <span asp-validation-for="NovoProduto.Preco" class="text-danger"></span>
                </div>

                <div class="admin-field">
                    <label asp-for="NovoProduto.EstoqueInicial" class="admin-label">Estoque Inicial (unidades)</label>
                    <input asp-for="NovoProduto.EstoqueInicial" type="number" min="0" class="admin-input" placeholder="Ex: 15" />
                    <span asp-validation-for="NovoProduto.EstoqueInicial" class="text-danger"></span>
                </div>
            </div>

            <div class="admin-field">
                <label asp-for="NovoProduto.Descricao" class="admin-label">Descrição Detalhada do Produto (Opcional)</label>
                <textarea asp-for="NovoProduto.Descricao" class="admin-input" rows="3" placeholder="Informações técnicas, diferenciais e detalhes do instrumento..."></textarea>
                <span asp-validation-for="NovoProduto.Descricao" class="text-danger"></span>
            </div>

            <div class="admin-form-row">
                <div class="admin-field">
                    <label asp-for="NovoProduto.ImagemArquivo" class="admin-label">Upload de Imagem</label>
                    <input asp-for="NovoProduto.ImagemArquivo" type="file" accept="image/png, image/jpeg, image/webp" class="admin-input" style="padding: 0.45rem 0.75rem;" />
                    <span asp-validation-for="NovoProduto.ImagemArquivo" class="text-danger"></span>
                    <small style="color: var(--muted); font-size: 0.8rem; margin-top: 0.3rem; display: block;">
                        A imagem selecionada será gravada automaticamente em <code>wwwroot/img/uploads</code>.
                    </small>
                </div>

                <div class="admin-field">
                    <label asp-for="NovoProduto.ImagemUrl" class="admin-label">URL Externa / Imagem Manual (Opcional)</label>
                    <input asp-for="NovoProduto.ImagemUrl" class="admin-input" placeholder="Ex: /img/uploads/guitarra.jpg" />
                    <span asp-validation-for="NovoProduto.ImagemUrl" class="text-danger"></span>
                    <small style="color: var(--muted); font-size: 0.8rem; margin-top: 0.3rem; display: block;">
                        Se vazio e sem arquivo, será utilizada a imagem padrão da categoria.
                    </small>
                </div>
            </div>

            <button type="submit" class="admin-btn">Cadastrar produto</button>
        </form>
    </div>

    <!-- CARD 2: Adicionar Estoque -->
    <div class="admin-card">
        <div class="admin-card-header">
            <div>
                <h2 class="admin-card-titulo">Entrada de Estoque</h2>
                <p class="admin-card-sub">Incremente o saldo físico de um item já existente no banco de dados</p>
            </div>
        </div>

        <form asp-controller="Admin" asp-action="AdicionarEstoque" method="post" class="admin-form">
            @Html.AntiForgeryToken()

            <div class="admin-form-row">
                <div class="admin-field">
                    <label asp-for="AdicionarEstoque.IdProduto" class="admin-label">Selecionar Instrumento</label>
                    <select asp-for="AdicionarEstoque.IdProduto" class="admin-select" required>
                        <option value="" disabled selected>Selecione um produto</option>
                        @foreach (var p in Model.ProdutosCadastrados)
                        {
                            <option value="@p.IdProduto">
                                [@p.TipoInstrumento] @p.Modelo — R$ @p.Preco.ToString("N2") [Atual: @(p.Estoque?.QuantidadeDisponivel ?? 0) un] @(!p.Ativo ? "(Inativo)" : "")
                            </option>
                        }
                    </select>
                    <span asp-validation-for="AdicionarEstoque.IdProduto" class="text-danger"></span>
                </div>

                <div class="admin-field">
                    <label asp-for="AdicionarEstoque.Quantidade" class="admin-label">Quantidade a Adicionar</label>
                    <input asp-for="AdicionarEstoque.Quantidade" type="number" min="1" class="admin-input" placeholder="Ex: 10" required />
                    <span asp-validation-for="AdicionarEstoque.Quantidade" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="admin-btn">Atualizar Saldo de Estoque</button>
        </form>
    </div>

    <!-- CARD 3: Gestão de Cupons de Desconto -->
    <div class="admin-card">
        <div class="admin-card-header">
            <div>
                <h2 class="admin-card-titulo">Gestão de Cupons de Desconto</h2>
                <p class="admin-card-sub">Cadastre e gerencie cupons de 1% a 99% com desativação lógica (soft delete)</p>
            </div>
        </div>

        <form asp-controller="Admin" asp-action="CadastrarCupom" method="post" class="admin-form">
            @Html.AntiForgeryToken()

            <div class="admin-form-row">
                <div class="admin-field">
                    <label asp-for="NovoCupom.Valor" class="admin-label">Código do Cupom</label>
                    <input asp-for="NovoCupom.Valor" class="admin-input" placeholder="Código de ativação" style="text-transform: uppercase;" required />
                    <span asp-validation-for="NovoCupom.Valor" class="text-danger"></span>
                </div>

                <div class="admin-field">
                    <label asp-for="NovoCupom.Desconto" class="admin-label">Desconto do Cupom (Porcentagem de 1% a 99%)</label>
                    <input asp-for="NovoCupom.Desconto" type="number" min="1" max="990" class="admin-input" placeholder="Ex: 50 (para 50% de desconto)" required />
                    <span asp-validation-for="NovoCupom.Desconto" class="text-danger"></span>
                    <small style="color: var(--muted); font-size: 0.8rem; margin-top: 0.3rem; display: block;">
                        Digite o desconto desejado (ex: digite 50 para conceder 50% de desconto).
                    </small>
                </div>
            </div>

            <button type="submit" class="admin-btn">Registrar cupom</button>
        </form>

        <div style="margin-top: 2rem;">
            <h3 style="font-size: 1.05rem; font-weight: 600; margin-bottom: 0.8rem; color: #f1f5f9;">Cupons Cadastrados no Banco</h3>
            <div style="overflow-x: auto;">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Código / String</th>
                            <th>Desconto</th>
                            <th>Status</th>
                            <th>Criado Em</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.CuponsCadastrados.Any())
                        {
                            @foreach (var c in Model.CuponsCadastrados)
                            {
                                <tr>
                                    <td>@c.IdCupom</td>
                                    <td><strong style="color: #a78bfa; font-family: monospace; font-size: 1rem;">@c.Valor</strong></td>
                                    <td><span style="color: #34d399; font-weight: 700;">@c.Desconto% OFF</span></td>
                                    <td>
                                        @if (c.Ativo)
                                        {
                                            <span class="admin-badge-active">Ativo</span>
                                        }
                                        else
                                        {
                                            <span class="admin-badge-inactive">Desativado</span>
                                        }
                                    </td>
                                    <td>@c.DataCriacao.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <form asp-controller="Admin" asp-action="AlternarStatusCupom" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@c.IdCupom" />
                                            @if (c.Ativo)
                                            {
                                                <button type="submit" class="admin-btn-action-danger" title="Desativar cupom da loja">Desativar</button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="admin-btn-action-success" title="Reativar cupom para uso">Ativar</button>
                                            }
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" style="text-align: center; color: var(--muted); padding: 1.5rem;">
                                    Nenhum cupom cadastrado no momento.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- CARD 4: Tabela de Produtos Cadastrados -->
    <div class="admin-card">
        <div class="admin-card-header">
            <div>
                <h2 class="admin-card-titulo">Catálogo de Instrumentos Cadastrados</h2>
                <p class="admin-card-sub">Listagem de todos os instrumentos cadastrados na base com edição direta e desativação lógica</p>
            </div>
        </div>

        <div style="overflow-x: auto;">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Foto</th>
                        <th>Categoria Oficial</th>
                        <th>Modelo / Especificação</th>
                        <th>Descrição</th>
                        <th>Preço</th>
                        <th>Estoque</th>
                        <th>Status</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ProdutosCadastrados.Any())
                    {
                        @foreach (var item in Model.ProdutosCadastrados)
                        {
                            <tr>
                                <td>@item.IdProduto</td>
                                <td>
                                    @{
                                        string imgThumb = !string.IsNullOrWhiteSpace(item.ImagemUrl) ? item.ImagemUrl : "/img/logo.png";
                                    }
                                    <img src="@imgThumb" alt="@item.Modelo" style="width: 44px; height: 44px; object-fit: cover; border-radius: 4px; border: 1px solid rgba(255, 255, 255, 0.1);" onerror="this.onerror=null;this.src='/img/logo.png';" />
                                </td>
                                <td><span style="background: rgba(124, 58, 237, 0.2); padding: 0.2rem 0.5rem; border-radius: 4px; font-weight: 600;">@item.TipoInstrumento</span></td>
                                <td><strong>@item.Modelo</strong></td>
                                <td style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--muted); font-size: 0.85rem;" title="@item.Descricao">
                                    @(string.IsNullOrWhiteSpace(item.Descricao) ? "—" : item.Descricao)
                                </td>
                                <td>R$ @item.Preco.ToString("N2")</td>
                                <td>@(item.Estoque?.QuantidadeDisponivel ?? 0) un</td>
                                <td>
                                    @if (item.Ativo)
                                    {
                                        <span class="admin-badge-active">Ativo</span>
                                    }
                                    else
                                    {
                                        <span class="admin-badge-inactive">Desativado</span>
                                    }
                                </td>
                                <td style="white-space: nowrap;">
                                    <button type="button" 
                                            class="admin-btn-action-edit"
                                            onclick="abrirModalEdicao('@item.IdProduto', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(item.TipoInstrumento))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(item.Modelo))', '@item.Preco.ToString(System.Globalization.CultureInfo.InvariantCulture)', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(item.Descricao ?? ""))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(item.ImagemUrl ?? ""))', @(item.Ativo ? "true" : "false"))">
                                        Editar
                                    </button>
                                    <form asp-controller="Admin" asp-action="AlternarStatusProduto" method="post" style="display:inline; margin-left: 0.4rem;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.IdProduto" />
                                        @if (item.Ativo)
                                        {
                                            <button type="submit" class="admin-btn-action-danger" title="Desativar produto da loja (soft delete)">Desativar</button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="admin-btn-action-success" title="Reativar produto na loja">Ativar</button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" style="text-align: center; color: var(--muted); padding: 2rem;">
                                Nenhum instrumento cadastrado no banco de dados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- CARD 5: Log de Auditoria e Triggers Relacionais -->
    @if (Model.RegistrosAuditoria.Any())
    {
        <div class="admin-card" style="margin-top: 2rem;">
            <div class="admin-card-header">
                <div>
                    <h2 class="admin-card-titulo">Auditoria de Vendas (Trigger trg_AuditoriaVendas)</h2>
                    <p class="admin-card-sub">Eventos capturados automaticamente pelo SGBD SQL Server</p>
                </div>
            </div>
            <div class="admin-table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>ID Auditoria</th>
                            <th>ID Venda</th>
                            <th>Cód. Cliente</th>
                            <th>Data / Hora</th>
                            <th>Operação</th>
                            <th>Usuário SGBD</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var audit in Model.RegistrosAuditoria)
                        {
                            <tr>
                                <td>@audit.IdAuditoria</td>
                                <td><strong>#@audit.IdVenda</strong></td>
                                <td>@audit.CodCliente</td>
                                <td>@audit.DataAcao.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td>
                                    <span style="background: rgba(34, 197, 94, 0.15); color: #4ade80; padding: 0.2rem 0.5rem; border-radius: 4px; font-weight: 600;">
                                        @audit.TipoAcao
                                    </span>
                                </td>
                                <td><code>@audit.UsuarioSO</code></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- MODAL: Editar Produto -->
<div id="modalEditarProduto" class="admin-modal-backdrop" onclick="fecharModalEdicaoAoClicarFora(event)">
    <div class="admin-modal" onclick="event.stopPropagation()">
        <div class="admin-modal-header">
            <div>
                <h3 style="font-family: 'Playfair Display', Georgia, serif; font-size: 1.4rem; font-weight: 700; color: var(--text-heading); margin-bottom: 0.2rem;">Editar Instrumento</h3>
                <p style="font-size: 0.85rem; color: var(--muted); margin: 0;">Atualize as informações cadastrais do produto sem recriá-lo</p>
            </div>
            <button type="button" class="admin-modal-close" onclick="fecharModalEdicao()">&times;</button>
        </div>

        <form asp-controller="Admin" asp-action="EditarProduto" method="post" enctype="multipart/form-data" class="admin-form">
            @Html.AntiForgeryToken()
            <input type="hidden" id="editIdProduto" name="EditarProduto.IdProduto" />

            <div class="admin-form-row">
                <div class="admin-field">
                    <label class="admin-label" for="editNome">Categoria do Produto</label>
                    <select id="editNome" name="EditarProduto.Nome" class="admin-select" required>
                        <option value="Guitarras">Guitarras</option>
                        <option value="Violões">Violões</option>
                        <option value="Teclados">Teclados</option>
                        <option value="Baterias">Baterias</option>
                        <option value="Outros">Outros</option>
                        <option value="Acessórios">Acessórios</option>
                    </select>
                </div>

                <div class="admin-field">
                    <label class="admin-label" for="editModelo">Modelo / Especificação</label>
                    <input id="editModelo" name="EditarProduto.Modelo" class="admin-input" required />
                </div>
            </div>

            <div class="admin-form-row">
                <div class="admin-field">
                    <label class="admin-label" for="editPreco">Preço Unitário (R$)</label>
                    <input id="editPreco" name="EditarProduto.Preco" type="number" step="0.01" min="0.01" class="admin-input" required />
                </div>

                <div class="admin-field">
                    <label class="admin-label" for="editAtivo">Status do Produto</label>
                    <select id="editAtivo" name="EditarProduto.Ativo" class="admin-select">
                        <option value="true">Ativo (visível no catálogo)</option>
                        <option value="false">Desativado (oculto no catálogo)</option>
                    </select>
                </div>
            </div>

            <div class="admin-field">
                <label class="admin-label" for="editDescricao">Descrição Detalhada do Produto</label>
                <textarea id="editDescricao" name="EditarProduto.Descricao" class="admin-input" rows="3" placeholder="Informações técnicas, diferenciais e detalhes do instrumento..."></textarea>
            </div>

            <div class="admin-form-row">
                <div class="admin-field">
                    <label class="admin-label" for="editImagemArquivo">Substituir Imagem (Upload)</label>
                    <input id="editImagemArquivo" name="EditarProduto.ImagemArquivo" type="file" accept="image/png, image/jpeg, image/webp" class="admin-input" style="padding: 0.45rem 0.75rem;" />
                    <small style="color: var(--muted); font-size: 0.8rem; margin-top: 0.3rem; display: block;">
                        Deixe em branco para manter a imagem atual.
                    </small>
                </div>

                <div class="admin-field">
                    <label class="admin-label" for="editImagemUrl">URL Externa da Imagem</label>
                    <input id="editImagemUrl" name="EditarProduto.ImagemUrl" class="admin-input" placeholder="Ex: /img/uploads/guitarra.jpg" />
                </div>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 1rem; margin-top: 1rem;">
                <button type="button" class="admin-btn" style="background: var(--surface2); border: 1px solid var(--border); color: var(--text);" onclick="fecharModalEdicao()">Cancelar</button>
                <button type="submit" class="admin-btn">Salvar Alterações</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function abrirModalEdicao(id, nome, modelo, preco, descricao, imagemUrl, ativo) {
            document.getElementById('editIdProduto').value = id;
            document.getElementById('editNome').value = nome;
            document.getElementById('editModelo').value = modelo;
            document.getElementById('editPreco').value = preco;
            document.getElementById('editDescricao').value = descricao || '';
            document.getElementById('editImagemUrl').value = imagemUrl || '';
            document.getElementById('editAtivo').value = ativo ? 'true' : 'false';
            document.getElementById('modalEditarProduto').classList.add('active');
        }

        function fecharModalEdicao() {
            document.getElementById('modalEditarProduto').classList.remove('active');
        }

        function fecharModalEdicaoAoClicarFora(event) {
            if (event.target === document.getElementById('modalEditarProduto')) {
                fecharModalEdicao();
            }
        }
    </script>
}
