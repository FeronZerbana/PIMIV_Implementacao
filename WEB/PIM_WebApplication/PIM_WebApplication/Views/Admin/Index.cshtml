@model PIM_WebApplication.ViewModels.AdminViewModel
@{
    ViewData["Title"] = "Painel do Administrador";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="admin-topo">
    <a asp-controller="Home" asp-action="Index" class="admin-btn-voltar">&larr; Voltar para a Loja</a>
</div>

<div class="admin-header">
    <h1 class="admin-titulo">Painel de Administrador</h1>
    <p class="admin-subtitulo">Gerencie produtos e o estoque da Loja de Instrumentos Musicais</p>
</div>

<div class="admin-wrapper">
    <!-- Card 1: Cadastrar Novo Produto -->
    <div class="admin-card">
        <div class="admin-card-header">
            <div>
                <h2 class="admin-card-titulo">Cadastrar Novo Produto</h2>
                <p class="admin-card-sub">Adicione um novo instrumento ou acessório e seu estoque inicial ao catálogo</p>
            </div>
        </div>

        <form asp-controller="Admin" asp-action="CadastrarProduto" method="post" class="admin-form">
            @Html.AntiForgeryToken()

            <div class="admin-form-row">
                <div class="admin-field">
                    <label asp-for="NovoProduto.Nome" class="admin-label">Nome do Produto</label>
                    <input asp-for="NovoProduto.Nome" class="admin-input" placeholder="Ex: Saxofone Alto Michael ou Cabo P10 Ninja" />
                    <span asp-validation-for="NovoProduto.Nome" class="text-danger"></span>
                </div>

                <div class="admin-field">
                    <label asp-for="NovoProduto.Preco" class="admin-label">Preço (R$)</label>
                    <input asp-for="NovoProduto.Preco" type="number" step="0.01" class="admin-input" placeholder="Ex: 2499.90" />
                    <span asp-validation-for="NovoProduto.Preco" class="text-danger"></span>
                </div>
            </div>

            <div class="admin-form-row">
                <div class="admin-field">
                    <label class="admin-label">Categoria / Tipo</label>
                    <select id="instrumentType" class="admin-select">
                        <option value="" disabled selected>Selecione uma categoria</option>
                        <option value="Guitarra">Guitarra</option>
                        <option value="Violão">Violão</option>
                        <option value="Teclado">Teclado</option>
                        <option value="Bateria">Bateria</option>
                        <option value="Outros">Outros</option>
                        <option value="Acessórios">Acessórios</option>
                    </select>
                </div>

                <div class="admin-field">
                    <label asp-for="NovoProduto.Modelo" class="admin-label">Modelo / Subtipo</label>
                    <select asp-for="NovoProduto.Modelo" class="admin-select" id="modeloSelect">
                        <option value="" disabled selected>Selecione um modelo</option>
                        <!-- Guitarra -->
                        <option class="guitarra" value="Stratocaster">Stratocaster</option>
                        <option class="guitarra" value="Telecaster">Telecaster</option>
                        <option class="guitarra" value="Les Paul">Les Paul</option>
                        <option class="guitarra" value="Superstrato">Superstrato</option>
                        <!-- Violão -->
                        <option class="violao" value="Clássico">Clássico</option>
                        <option class="violao" value="Folk">Folk</option>
                        <option class="violao" value="Jumbo">Jumbo</option>
                        <!-- Teclado -->
                        <option class="teclado" value="Arranjadores">Arranjadores</option>
                        <option class="teclado" value="Pianos Digitais">Pianos Digitais</option>
                        <option class="teclado" value="Sintetizadores">Sintetizadores</option>
                        <!-- Bateria -->
                        <option class="bateria" value="Acústica">Acústica</option>
                        <option class="bateria" value="Eletrônica">Eletrônica</option>
                        <option class="bateria" value="Compacta">Compacta</option>
                        <!-- Outros -->
                        <option class="outros" value="Saxofone">Saxofone</option>
                        <option class="outros" value="Violino">Violino</option>
                        <option class="outros" value="Flauta">Flauta</option>
                        <option class="outros" value="Trompete">Trompete</option>
                        <option class="outros" value="Acordeon">Acordeon</option>
                        <option class="outros" value="Gaita">Gaita</option>
                        <option class="outros" value="Ukulele">Ukulele</option>
                        <!-- Acessórios -->
                        <option class="acessorios" value="Cabos">Cabos</option>
                        <option class="acessorios" value="Afinadores">Afinadores</option>
                        <option class="acessorios" value="Palhetas">Palhetas</option>
                        <option class="acessorios" value="Correias">Correias</option>
                        <option class="acessorios" value="Suportes">Suportes</option>
                        <option class="acessorios" value="Cordas">Cordas</option>
                        <option class="acessorios" value="Capotrastes">Capotrastes</option>
                        <option class="acessorios" value="Bags e Cases">Bags e Cases</option>
                    </select>
                    <span asp-validation-for="NovoProduto.Modelo" class="text-danger"></span>
                </div>
            </div>

            <div class="admin-form-row">
                <div class="admin-field">
                    <label asp-for="NovoProduto.EstoqueInicial" class="admin-label">Estoque Inicial</label>
                    <input asp-for="NovoProduto.EstoqueInicial" type="number" min="0" class="admin-input" placeholder="Ex: 10" />
                    <span asp-validation-for="NovoProduto.EstoqueInicial" class="text-danger"></span>
                </div>
                <div class="admin-field">
                    <label asp-for="NovoProduto.ImagemUrl" class="admin-label">URL da Imagem (opcional)</label>
                    <input asp-for="NovoProduto.ImagemUrl" class="admin-input" placeholder="Ex: /img/guitarra.png ou URL de upload" />
                    <span asp-validation-for="NovoProduto.ImagemUrl" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="admin-btn">Cadastrar Produto</button>
        </form>
    </div>

    <!-- Card 2: Adicionar Estoque -->
    <div class="admin-card">
        <div class="admin-card-header">
            <div>
                <h2 class="admin-card-titulo">Adicionar Estoque</h2>
                <p class="admin-card-sub">Aumente a quantidade disponível de um produto existente</p>
            </div>
        </div>

        <form asp-controller="Admin" asp-action="AdicionarEstoque" method="post" class="admin-form">
            @Html.AntiForgeryToken()

            <div class="admin-form-row">
                <div class="admin-field">
                    <label asp-for="AdicionarEstoque.IdProduto" class="admin-label">Selecione um produto</label>
                    <select asp-for="AdicionarEstoque.IdProduto" class="admin-select">
                        <option value="" disabled selected>Selecione um produto</option>
                        @foreach (var p in Model.ProdutosCadastrados)
                        {
                            <option value="@p.IdProduto">
                                @p.TipoInstrumento (Modelo: @p.Modelo) — R$ @p.Preco.ToString("N2") [Atual: @(p.Estoque?.QuantidadeDisponivel ?? 0) un]
                            </option>
                        }
                    </select>
                    <span asp-validation-for="AdicionarEstoque.IdProduto" class="text-danger"></span>
                </div>

                <div class="admin-field">
                    <label asp-for="AdicionarEstoque.Quantidade" class="admin-label">Quantidade</label>
                    <input asp-for="AdicionarEstoque.Quantidade" type="number" min="1" class="admin-input" placeholder="Ex: 10" />
                    <span asp-validation-for="AdicionarEstoque.Quantidade" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="admin-btn">Adicionar Estoque</button>
        </form>
    </div>

    <!-- Card 3: Lista de Produtos Cadastrados -->
    <div class="admin-card">
        <div class="admin-card-header">
            <div>
                <h2 class="admin-card-titulo">Produtos no Catálogo</h2>
                <p class="admin-card-sub">Visualização e controle de todos os itens cadastrados</p>
            </div>
        </div>

        <div style="overflow-x: auto;">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Produto / Instrumento</th>
                        <th>Modelo / Tipo</th>
                        <th>Preço</th>
                        <th>Estoque</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ProdutosCadastrados.Any())
                    {
                        @foreach (var item in Model.ProdutosCadastrados)
                        {
                            <tr>
                                <td>@item.IdProduto</td>
                                <td><strong>@item.TipoInstrumento</strong></td>
                                <td>@item.Modelo</td>
                                <td>R$ @item.Preco.ToString("N2")</td>
                                <td>@(item.Estoque?.QuantidadeDisponivel ?? 0) un</td>
                                <td>
                                    <form asp-controller="Admin" asp-action="ExcluirProduto" method="post" onsubmit="return confirm('Deseja realmente excluir este produto?');" style="display:inline;">
                                        <input type="hidden" name="id" value="@item.IdProduto" />
                                        <button type="submit" style="background:none; border:none; color:var(--danger); cursor:pointer; font-size:0.85rem; font-weight:600; text-decoration:underline;">Excluir</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" style="text-align: center; color: var(--muted); padding: 2rem;">
                                Nenhum produto cadastrado.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Filtra modelos de acordo com o tipo de instrumento ou acessorio selecionado
        document.getElementById('instrumentType')?.addEventListener('change', function () {
            var selected = (this.value || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, "");
            var modeloSelect = document.getElementById('modeloSelect');
            for (var i = 0; i < modeloSelect.options.length; i++) {
                var opt = modeloSelect.options[i];
                var cls = (opt.className || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, "");
                if (!opt.value) { // placeholder option
                    opt.hidden = false;
                    continue;
                }
                opt.hidden = (cls !== selected);
            }
            modeloSelect.value = "";
        });
    </script>
}
