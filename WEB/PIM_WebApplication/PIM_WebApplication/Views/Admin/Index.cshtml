@model PIM_WebApplication.ViewModels.AdminViewModel
@{
    ViewData["Title"] = "Painel Administrativo";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="admin-wrapper">
    <div class="admin-header">
        <div>
            <h1 class="admin-title">Painel Administrativo</h1>
            <p class="admin-subtitle">Gestão de catálogo de instrumentos musicais, estoques e cupons de desconto.</p>
        </div>
    </div>

    @if (TempData["MensagemToast"] != null)
    {
        <div style="background: rgba(124, 58, 237, 0.15); border: 1px solid var(--accent); color: var(--text-heading); padding: 1rem 1.25rem; border-radius: 8px; margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: space-between; font-weight: 500;">
            <span>@TempData["MensagemToast"]</span>
            <button type="button" onclick="this.parentElement.remove()" style="background: none; border: none; color: var(--muted); cursor: pointer; font-size: 1.2rem; line-height: 1;">&times;</button>
        </div>
    }

    <!-- CARD 1: Cadastrar Novo Produto -->
    <div class="admin-card">
        <div class="admin-card-header">
            <div>
                <h2 class="admin-card-titulo">Cadastrar Novo Instrumento</h2>
                <p class="admin-card-sub">Adicione um novo instrumento ou acessório ao catálogo oficial da loja</p>
            </div>
        </div>

        <form asp-controller="Admin" asp-action="CadastrarProduto" method="post" enctype="multipart/form-data" class="admin-form">
            @Html.AntiForgeryToken()

            <div class="admin-form-row">
                <div class="admin-field">
                    <label asp-for="NovoProduto.Nome" class="admin-label">Categoria do Instrumento</label>
                    <select asp-for="NovoProduto.Nome" id="instrumentCategory" class="admin-select" required>
                        <option value="" disabled selected>Selecione uma categoria oficial</option>
                        <option value="Guitarras">Guitarras</option>
                        <option value="Violões">Violões</option>
                        <option value="Teclados">Teclados</option>
                        <option value="Baterias">Baterias</option>
                        <option value="Outros">Outros</option>
                        <option value="Acessórios">Acessórios</option>
                    </select>
                    <span asp-validation-for="NovoProduto.Nome" class="text-danger"></span>
                </div>

                <div class="admin-field">
                    <label asp-for="NovoProduto.Modelo" class="admin-label">Modelo / Especificação</label>
                    <input asp-for="NovoProduto.Modelo" class="admin-input" placeholder="Ex: Stratocaster Sunburst Maple ou Cabo P10 5m" required />
                    <span asp-validation-for="NovoProduto.Modelo" class="text-danger"></span>
                </div>
            </div>

            <div class="admin-form-row">
                <div class="admin-field">
                    <label asp-for="NovoProduto.Preco" class="admin-label">Preço Unitário (R$)</label>
                    <input asp-for="NovoProduto.Preco" type="number" step="0.01" min="0.01" class="admin-input" placeholder="Ex: 2499.90" required />
                    <span asp-validation-for="NovoProduto.Preco" class="text-danger"></span>
                </div>

                <div class="admin-field">
                    <label asp-for="NovoProduto.EstoqueInicial" class="admin-label">Estoque Inicial (unidades)</label>
                    <input asp-for="NovoProduto.EstoqueInicial" type="number" min="0" class="admin-input" placeholder="Ex: 15" />
                    <span asp-validation-for="NovoProduto.EstoqueInicial" class="text-danger"></span>
                </div>
            </div>

            <div class="admin-form-row">
                <div class="admin-field">
                    <label asp-for="NovoProduto.ImagemArquivo" class="admin-label">Upload de Imagem (do seu computador)</label>
                    <input asp-for="NovoProduto.ImagemArquivo" type="file" accept="image/png, image/jpeg, image/webp" class="admin-input" style="padding: 0.45rem 0.75rem;" />
                    <span asp-validation-for="NovoProduto.ImagemArquivo" class="text-danger"></span>
                    <small style="color: var(--muted); font-size: 0.8rem; margin-top: 0.3rem; display: block;">
                        A imagem selecionada será gravada automaticamente em <code>wwwroot/img/uploads</code>.
                    </small>
                </div>

                <div class="admin-field">
                    <label asp-for="NovoProduto.ImagemUrl" class="admin-label">Ou URL Externa / Imagem Manual (Opcional)</label>
                    <input asp-for="NovoProduto.ImagemUrl" class="admin-input" placeholder="Ex: /img/guitarra.jpeg ou URL externa" />
                    <span asp-validation-for="NovoProduto.ImagemUrl" class="text-danger"></span>
                    <small style="color: var(--muted); font-size: 0.8rem; margin-top: 0.3rem; display: block;">
                        Se vazio e sem arquivo, será utilizada a imagem padrão da categoria selecionada.
                    </small>
                </div>
            </div>

            <button type="submit" class="admin-btn">Cadastrar Instrumento</button>
        </form>
    </div>

    <!-- CARD 2: Adicionar Estoque -->
    <div class="admin-card">
        <div class="admin-card-header">
            <div>
                <h2 class="admin-card-titulo">Entrada de Estoque</h2>
                <p class="admin-card-sub">Incremente o saldo físico de um item já existente no banco de dados</p>
            </div>
        </div>

        <form asp-controller="Admin" asp-action="AdicionarEstoque" method="post" class="admin-form">
            @Html.AntiForgeryToken()

            <div class="admin-form-row">
                <div class="admin-field">
                    <label asp-for="AdicionarEstoque.IdProduto" class="admin-label">Selecionar Instrumento</label>
                    <select asp-for="AdicionarEstoque.IdProduto" class="admin-select" required>
                        <option value="" disabled selected>Selecione um produto</option>
                        @foreach (var p in Model.ProdutosCadastrados)
                        {
                            <option value="@p.IdProduto">
                                [@p.TipoInstrumento] @p.Modelo — R$ @p.Preco.ToString("N2") [Atual: @(p.Estoque?.QuantidadeDisponivel ?? 0) un]
                            </option>
                        }
                    </select>
                    <span asp-validation-for="AdicionarEstoque.IdProduto" class="text-danger"></span>
                </div>

                <div class="admin-field">
                    <label asp-for="AdicionarEstoque.Quantidade" class="admin-label">Quantidade a Adicionar</label>
                    <input asp-for="AdicionarEstoque.Quantidade" type="number" min="1" class="admin-input" placeholder="Ex: 10" required />
                    <span asp-validation-for="AdicionarEstoque.Quantidade" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="admin-btn">Atualizar Saldo de Estoque</button>
        </form>
    </div>

    <!-- CARD 3: Gestão de Cupons de Desconto -->
    <div class="admin-card">
        <div class="admin-card-header">
            <div>
                <h2 class="admin-card-titulo">Gestão de Cupons de Desconto</h2>
                <p class="admin-card-sub">Cadastre novos cupons de 1% a 99% válidos imediatamente na loja</p>
            </div>
        </div>

        <form asp-controller="Admin" asp-action="CadastrarCupom" method="post" class="admin-form">
            @Html.AntiForgeryToken()

            <div class="admin-form-row">
                <div class="admin-field">
                    <label asp-for="NovoCupom.Valor" class="admin-label">Código do Cupom (String)</label>
                    <input asp-for="NovoCupom.Valor" class="admin-input" placeholder="Ex: ROCK15, DEV10, PROMO25" style="text-transform: uppercase;" required />
                    <span asp-validation-for="NovoCupom.Valor" class="text-danger"></span>
                </div>

                <div class="admin-field">
                    <label asp-for="NovoCupom.Desconto" class="admin-label">Percentual de Desconto (1 a 99%)</label>
                    <input asp-for="NovoCupom.Desconto" type="number" min="1" max="99" class="admin-input" placeholder="Ex: 15 (para 15% OFF)" required />
                    <span asp-validation-for="NovoCupom.Desconto" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="admin-btn">Registrar Cupom no Banco</button>
        </form>

        <div style="margin-top: 2rem;">
            <h3 style="font-size: 1.05rem; font-weight: 600; margin-bottom: 0.8rem; color: #f1f5f9;">Cupons Cadastrados no Banco</h3>
            <div style="overflow-x: auto;">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Código / String</th>
                            <th>Desconto</th>
                            <th>Status</th>
                            <th>Criado Em</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.CuponsCadastrados.Any())
                        {
                            @foreach (var c in Model.CuponsCadastrados)
                            {
                                <tr>
                                    <td>@c.IdCupom</td>
                                    <td><strong style="color: #a78bfa; font-family: monospace; font-size: 1rem;">@c.Valor</strong></td>
                                    <td><span style="color: #34d399; font-weight: 700;">@c.Desconto% OFF</span></td>
                                    <td>@(c.Ativo ? "Ativo" : "Inativo")</td>
                                    <td>@c.DataCriacao.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <form asp-controller="Admin" asp-action="ExcluirCupom" method="post" onsubmit="return confirm('Deseja realmente remover este cupom?');" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@c.IdCupom" />
                                            <button type="submit" style="background:none; border:none; color:var(--danger); cursor:pointer; font-size:0.85rem; font-weight:600; text-decoration:underline;">Remover</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" style="text-align: center; color: var(--muted); padding: 1.5rem;">
                                    Nenhum cupom cadastrado no momento.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- CARD 4: Tabela de Produtos Cadastrados -->
    <div class="admin-card">
        <div class="admin-card-header">
            <div>
                <h2 class="admin-card-titulo">Catálogo de Instrumentos Cadastrados</h2>
                <p class="admin-card-sub">Listagem de todos os instrumentos ativos na base relacional do sistema</p>
            </div>
        </div>

        <div style="overflow-x: auto;">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Foto</th>
                        <th>Categoria Oficial</th>
                        <th>Modelo / Descrição</th>
                        <th>Preço</th>
                        <th>Estoque</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ProdutosCadastrados.Any())
                    {
                        @foreach (var item in Model.ProdutosCadastrados)
                        {
                            <tr>
                                <td>@item.IdProduto</td>
                                <td>
                                    @{
                                        string imgThumb = !string.IsNullOrWhiteSpace(item.ImagemUrl) ? item.ImagemUrl : "/img/logo.png";
                                    }
                                    <img src="@imgThumb" alt="@item.Modelo" style="width: 44px; height: 44px; object-fit: cover; border-radius: 4px; border: 1px solid rgba(255, 255, 255, 0.1);" onerror="this.onerror=null;this.src='/img/logo.png';" />
                                </td>
                                <td><span style="background: rgba(124, 58, 237, 0.2); padding: 0.2rem 0.5rem; border-radius: 4px; font-weight: 600;">@item.TipoInstrumento</span></td>
                                <td><strong>@item.Modelo</strong></td>
                                <td>R$ @item.Preco.ToString("N2")</td>
                                <td>@(item.Estoque?.QuantidadeDisponivel ?? 0) un</td>
                                <td>
                                    <form asp-controller="Admin" asp-action="ExcluirProduto" method="post" onsubmit="return confirm('Deseja realmente excluir este produto?');" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.IdProduto" />
                                        <button type="submit" style="background:none; border:none; color:var(--danger); cursor:pointer; font-size:0.85rem; font-weight:600; text-decoration:underline;">Excluir</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" style="text-align: center; color: var(--muted); padding: 2rem;">
                                Nenhum instrumento cadastrado no banco de dados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
