@{
    ViewData["Title"] = "Acessórios - Loja de Música";

    /* ==============================================================================
       DADOS DEMONSTRATIVOS PARA PRÉVIA VISUAL (FRONT-END)
       ------------------------------------------------------------------------------
       Estes dados demonstram a nova categoria de artefatos do tipo acessório
       (cabos, afinadores, palhetas, correias, suportes e bags), separados dos instrumentos.
       ============================================================================== */

    var instrumentos = new[]
    {
        new {
            Nome = "Cabo P10 Ninja Santo Angelo 3.05m",
            Marca = "SANTO ANGELO",
            Modelo = "Ninja P10 3m",
            Preco = 89.00m,
            ImagemUrl = Url.Content("~/img/acessorios.png"),
            MaisVendido = true
        },
        new {
            Nome = "Afinador Digital Clip-on Boss TU-02",
            Marca = "BOSS",
            Modelo = "TU-02 Cromático",
            Preco = 159.00m,
            ImagemUrl = Url.Content("~/img/acessorios.png"),
            MaisVendido = false
        },
        new {
            Nome = "Pack 12 Palhetas Dunlop Tortex Standard 0.88mm",
            Marca = "DUNLOP",
            Modelo = "Tortex 0.88mm Green",
            Preco = 79.00m,
            ImagemUrl = Url.Content("~/img/acessorios.png"),
            MaisVendido = false
        },
        new {
            Nome = "Correia D'Addario Planet Waves Polypropylene",
            Marca = "D'ADDARIO",
            Modelo = "50A01 Polypropylene",
            Preco = 69.00m,
            ImagemUrl = Url.Content("~/img/acessorios.png"),
            MaisVendido = false
        },
        new {
            Nome = "Suporte de Chão Hercules GS414B Auto Grip",
            Marca = "HERCULES",
            Modelo = "GS414B Plus Auto Grip",
            Preco = 299.00m,
            ImagemUrl = Url.Content("~/img/acessorios.png"),
            MaisVendido = false
        },
        new {
            Nome = "Encordoamento Guitarra 010 Elixir Nanoweb",
            Marca = "ELIXIR",
            Modelo = "Nanoweb Light 010-046",
            Preco = 129.00m,
            ImagemUrl = Url.Content("~/img/acessorios.png"),
            MaisVendido = false
        },
        new {
            Nome = "Capotraste Rápido G7th Nashville",
            Marca = "G7TH",
            Modelo = "Nashville Quick Change",
            Preco = 189.00m,
            ImagemUrl = Url.Content("~/img/acessorios.png"),
            MaisVendido = false
        },
        new {
            Nome = "Bag Luxo Acolchoado para Guitarra Solid Sound",
            Marca = "SOLID SOUND",
            Modelo = "Case Luxo 25mm",
            Preco = 329.00m,
            ImagemUrl = Url.Content("~/img/acessorios.png"),
            MaisVendido = false
        }
    };

    var marcas = new[] { "Santo Angelo", "Boss", "Dunlop", "D'Addario", "Hercules", "Elixir", "G7th", "Outras" };
    var tipos = new[] { "Cabos", "Afinadores", "Palhetas", "Correias", "Suportes", "Cordas", "Capotrastes", "Bags e Cases" };
}

@section Styles {
    <link rel="stylesheet" href="~/css/categorias.css" asp-append-version="true" />
}

<div class="categoria-page">
    <!-- CABEÇALHO -->
    <header class="categoria-header">
        <a asp-controller="Home" asp-action="Index" class="categoria-voltar">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            Voltar para produtos
        </a>

        <div class="categoria-header-main">
            <div class="categoria-titulo-bloco">
                <h1 class="categoria-titulo">Acessórios</h1>
                <p class="categoria-descricao">Cabos, palhetas, correias, afinadores e suportes para manter seu setup sempre pronto.</p>
            </div>

            <!-- Ilustração Neon em SVG: Cabo e Palheta -->
            <div class="categoria-neon-art" aria-hidden="true">
                <svg viewBox="0 0 220 90" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <!-- Cabo P10 enrolado -->
                    <ellipse cx="90" cy="50" rx="35" ry="25" stroke="#c084fc" stroke-width="2" stroke-dasharray="4 2" />
                    <ellipse cx="90" cy="52" rx="28" ry="18" stroke="#a855f7" stroke-width="2" />
                    <!-- Plug P10 -->
                    <rect x="135" y="42" width="22" height="7" rx="2" fill="#c084fc" />
                    <rect x="157" y="44" width="12" height="3" fill="#e9d5ff" />
                    <!-- Palheta de guitarra triangular -->
                    <path d="M185 25 C195 25, 205 35, 200 50 C195 62, 185 70, 180 72 C175 70, 165 62, 160 50 C155 35, 165 25, 185 25 Z"
                          stroke="#e9d5ff" stroke-width="2" fill="#a855f7" fill-opacity="0.3" transform="rotate(15 180 50)" />
                    <circle cx="180" cy="46" r="3" fill="#e9d5ff" />
                </svg>
            </div>
        </div>

        <div class="categoria-divider"></div>
    </header>

    <!-- BARRA DE ORDENAÇÃO -->
    <div class="categoria-toolbar">
        <label for="ordenarPor" class="toolbar-label">Ordenar por:</label>
        <div class="select-ordenar-wrapper">
            <select id="ordenarPor" class="select-ordenar" aria-label="Ordenar produtos">
                <option value="populares" selected>Mais populares</option>
                <option value="menor-preco">Menor preço</option>
                <option value="maior-preco">Maior preço</option>
                <option value="recentes">Mais recentes</option>
                <option value="avaliados">Mais avaliados</option>
            </select>
        </div>
    </div>

    <!-- CORPO PRINCIPAL: FILTROS + GRADE -->
    <div class="categoria-layout">
        <!-- PAINEL LATERAL DE FILTROS -->
        <aside class="categoria-sidebar" aria-label="Filtros de produtos">
            <div class="filtro-titulo-principal">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="4" y1="21" x2="4" y2="14"></line>
                    <line x1="4" y1="10" x2="4" y2="3"></line>
                    <line x1="12" y1="21" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12" y2="3"></line>
                    <line x1="20" y1="21" x2="20" y2="16"></line>
                    <line x1="20" y1="12" x2="20" y2="3"></line>
                    <line x1="1" y1="14" x2="7" y2="14"></line>
                    <line x1="9" y1="8" x2="15" y2="8"></line>
                    <line x1="17" y1="16" x2="23" y2="16"></line>
                </svg>
                <span>Filtrar</span>
            </div>

            <!-- Filtro de Marca -->
            <div class="filtro-secao">
                <div class="filtro-secao-header">
                    <span>Marca</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="18 15 12 9 6 15"></polyline>
                    </svg>
                </div>
                <ul class="filtro-lista">
                    @foreach (var marca in marcas)
                    {
                        <li>
                            <label class="filtro-item">
                                <input type="checkbox" name="marca" value="@marca" class="filtro-checkbox" />
                                <span>@marca</span>
                            </label>
                        </li>
                    }
                </ul>
            </div>

            <!-- Filtro de Tipo -->
            <div class="filtro-secao">
                <div class="filtro-secao-header">
                    <span>Tipo</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="18 15 12 9 6 15"></polyline>
                    </svg>
                </div>
                <ul class="filtro-lista">
                    @foreach (var tipo in tipos)
                    {
                        <li>
                            <label class="filtro-item">
                                <input type="checkbox" name="tipo" value="@tipo" class="filtro-checkbox" />
                                <span>@tipo</span>
                            </label>
                        </li>
                    }
                </ul>
            </div>

            <!-- Filtro de Faixa de Preço -->
            <div class="filtro-secao">
                <div class="filtro-secao-header">
                    <span>Faixa de preço</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </div>
                <div class="filtro-preco-box">
                    <input type="range" min="30" max="1000" value="300" class="preco-slider-range" aria-label="Faixa de preço" />
                    <div class="preco-valores">
                        <span>R$ 30</span>
                        <span>R$ 1.000+</span>
                    </div>
                </div>
            </div>
        </aside>

        <!-- GRADE DE PRODUTOS -->
        <main class="categoria-produtos-grid" role="region" aria-label="Lista de Acessórios">
            @foreach (var produto in instrumentos)
            {
                <article class="instrumento-card">
                    @if (produto.MaisVendido)
                    {
                        <span class="instrumento-badge">Mais vendido</span>
                    }

                    <div class="instrumento-img-area">
                        <img src="@produto.ImagemUrl" alt="@produto.Nome" class="instrumento-img" loading="lazy" />
                    </div>

                    <div class="instrumento-info">
                        <h2 class="instrumento-nome" title="@produto.Nome">@produto.Nome</h2>
                        <span class="instrumento-marca">@produto.Marca</span>
                        <div class="instrumento-preco">R$ @produto.Preco.ToString("N2", new System.Globalization.CultureInfo("pt-BR"))</div>

                        <form asp-controller="Carrinho" asp-action="Adicionar" method="post" style="display:inline;">
                            <input type="hidden" name="idProduto" value="@(Math.Abs((produto.Nome + produto.Modelo).GetHashCode()))" />
                            <input type="hidden" name="nome" value="@produto.Nome" />
                            <input type="hidden" name="preco" value="@produto.Preco.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            <input type="hidden" name="modelo" value="@produto.Modelo" />
                            <input type="hidden" name="tamanho" value="@produto.Modelo" />
                            <input type="hidden" name="imagemUrl" value="@produto.ImagemUrl" />
                            <button type="submit" class="btn-carrinho" title="Adicionar ao carrinho">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="9" cy="21" r="1"></circle>
                                    <circle cx="20" cy="21" r="1"></circle>
                                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                </svg>
                                <span>Adicionar ao carrinho</span>
                            </button>
                        </form>
                    </div>
                </article>
            }
        </main>
    </div>
</div>
