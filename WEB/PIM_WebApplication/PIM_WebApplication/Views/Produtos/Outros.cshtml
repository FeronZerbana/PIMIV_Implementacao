@model IEnumerable<PIM_WebApplication.Models.Produto>
@{
    ViewData["Title"] = "Outros Instrumentos - Loja de Música";
    var fallbackCategoria = Url.Content("~/img/outros.png");

    var marcas = new[] { "Yamaha", "Eagle", "Michael", "Weril", "Hohner", "Mahalo", "Outras" };
    var tipos = new[] { "Saxofone", "Violino", "Flauta", "Trompete", "Acordeon", "Gaita", "Ukulele", "Clarinete" };
}

@section Styles {
    <link rel="stylesheet" href="~/css/categorias.css" asp-append-version="true" />
}

<div class="categoria-page">
    <!-- CABEÇALHO -->
    <header class="categoria-header">
        <a asp-controller="Home" asp-action="Index" class="categoria-voltar">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            Voltar para produtos
        </a>

        <div class="categoria-header-main">
            <div class="categoria-titulo-bloco">
                <h1 class="categoria-titulo">Outros Instrumentos</h1>
                <p class="categoria-descricao">Sopros, cordas orquestrais e instrumentos tradicionais para enriquecer seus arranjos.</p>
            </div>

            <!-- Ilustração Neon em SVG: Saxofone e Clave de Sol -->
            <div class="categoria-neon-art" aria-hidden="true">
                <svg viewBox="0 0 220 90" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <!-- Curva do corpo do Saxofone -->
                    <path d="M70 15 L78 50 C80 68, 100 78, 118 72 C134 66, 142 50, 140 35 L150 25 C154 21, 160 25, 156 32 C152 42, 145 68, 122 78 C96 88, 70 76, 66 52 L60 15 Z"
                          stroke="#c084fc" stroke-width="2.2" stroke-linejoin="round" />
                    <!-- Campana do saxofone -->
                    <ellipse cx="148" cy="28" rx="14" ry="10" stroke="#a855f7" stroke-width="2" transform="rotate(-30 148 28)" />
                    <!-- Chaves do saxofone -->
                    <circle cx="75" cy="30" r="2.5" fill="#e9d5ff" />
                    <circle cx="76" cy="38" r="2.5" fill="#e9d5ff" />
                    <circle cx="78" cy="46" r="2.5" fill="#e9d5ff" />
                    <circle cx="82" cy="54" r="2.5" fill="#e9d5ff" />
                    <!-- Notas musicais -->
                    <path d="M180 20 L200 15 L200 35 L180 40 Z" stroke="#e9d5ff" stroke-width="1.5" fill="#c084fc" fill-opacity="0.3" />
                    <circle cx="180" cy="40" r="4" fill="#e9d5ff" />
                    <circle cx="200" cy="35" r="4" fill="#e9d5ff" />
                </svg>
            </div>
        </div>

        <div class="categoria-divider"></div>
    </header>

    <!-- BARRA DE ORDENAÇÃO -->
    <div class="categoria-toolbar">
        <label for="ordenarPor" class="toolbar-label">Ordenar por:</label>
        <div class="select-ordenar-wrapper">
            <select id="ordenarPor" class="select-ordenar" aria-label="Ordenar produtos">
                <option value="populares" selected>Mais populares</option>
                <option value="menor-preco">Menor preço</option>
                <option value="maior-preco">Maior preço</option>
            </select>
        </div>
    </div>

    <!-- CORPO PRINCIPAL: FILTROS + GRADE -->
    <div class="categoria-conteudo">
        <!-- BARRA LATERAL DE FILTROS -->
        <aside class="categoria-filtros" aria-label="Filtros de produtos">
            <h2 class="filtros-titulo">Filtros</h2>

            <!-- Filtro de Marca -->
            <div class="filtro-secao">
                <div class="filtro-secao-header">
                    <span>Marca</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="18 15 12 9 6 15"></polyline>
                    </svg>
                </div>
                <ul class="filtro-lista">
                    @foreach (var marca in marcas)
                    {
                        <li>
                            <label class="filtro-item">
                                <input type="checkbox" name="marca" value="@marca" class="filtro-checkbox" />
                                <span>@marca</span>
                            </label>
                        </li>
                    }
                </ul>
            </div>

            <!-- Filtro de Tipo -->
            <div class="filtro-secao">
                <div class="filtro-secao-header">
                    <span>Tipo</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="18 15 12 9 6 15"></polyline>
                    </svg>
                </div>
                <ul class="filtro-lista">
                    @foreach (var tipo in tipos)
                    {
                        <li>
                            <label class="filtro-item">
                                <input type="checkbox" name="tipo" value="@tipo" class="filtro-checkbox" />
                                <span>@tipo</span>
                            </label>
                        </li>
                    }
                </ul>
            </div>

            <!-- Filtro de Faixa de Preço -->
            <div class="filtro-secao">
                <div class="filtro-secao-header">
                    <span>Faixa de preço</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </div>
                <div class="filtro-preco-box">
                    <input type="range" min="300" max="10000" value="4000" class="preco-slider-range" aria-label="Faixa de preço" />
                    <div class="preco-valores">
                        <span>R$ 300</span>
                        <span>R$ 10.000+</span>
                    </div>
                </div>
            </div>
        </aside>

        <!-- GRADE DE PRODUTOS -->
        <main class="categoria-produtos-grid" role="region" aria-label="Lista de Outros Instrumentos">
            @if (Model != null && Model.Any())
            {
                @foreach (var produto in Model)
                {
                    var imgFinal = !string.IsNullOrWhiteSpace(produto.ImagemUrl) ? produto.ImagemUrl : fallbackCategoria;
                    var estoqueDisponivel = produto.Estoque?.QuantidadeDisponivel ?? 0;
                    var temEstoque = estoqueDisponivel > 0;

                    <article class="instrumento-card">
                        <div class="instrumento-img-area">
                            <img src="@imgFinal" alt="@produto.Modelo" class="instrumento-img" loading="lazy" onerror="this.onerror=null;this.src='@fallbackCategoria';" />
                        </div>

                        <div class="instrumento-info">
                            <h2 class="instrumento-nome" title="@produto.Modelo">@produto.Modelo</h2>
                            <span class="instrumento-marca">@produto.TipoInstrumento</span>
                            <div class="instrumento-preco">R$ @produto.Preco.ToString("N2", new System.Globalization.CultureInfo("pt-BR"))</div>

                            <form asp-controller="Carrinho" asp-action="Adicionar" method="post" style="display:inline;">
                                <input type="hidden" name="idProduto" value="@produto.IdProduto" />
                                <input type="hidden" name="nome" value="@produto.TipoInstrumento" />
                                <input type="hidden" name="preco" value="@produto.Preco.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                <input type="hidden" name="modelo" value="@produto.Modelo" />
                                <input type="hidden" name="tamanho" value="@produto.Modelo" />
                                <input type="hidden" name="imagemUrl" value="@imgFinal" />
                                <button type="submit" class="btn-carrinho" title="Adicionar ao carrinho" @(!temEstoque ? "disabled style='opacity:0.5;cursor:not-allowed;'" : "")>
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="9" cy="21" r="1"></circle>
                                        <circle cx="20" cy="21" r="1"></circle>
                                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                    </svg>
                                    <span>@(temEstoque ? "Adicionar ao carrinho" : "Fora de estoque")</span>
                                </button>
                            </form>
                        </div>
                    </article>
                }
            }
            else
            {
                <div style="grid-column: 1 / -1; text-align: center; padding: 4rem 1rem; color: var(--muted);">
                    <p style="font-size: 1.1rem; margin-bottom: 0.5rem;">Nenhum produto cadastrado nesta categoria no momento.</p>
                    <a asp-controller="Home" asp-action="Index" class="btn-hero" style="display:inline-block; margin-top:1rem;">Ver outras categorias</a>
                </div>
            }
        </main>
    </div>
</div>
