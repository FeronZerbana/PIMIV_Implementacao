@{
    ViewData["Title"] = "Teclados - Loja de Música";

    /* ==============================================================================
       DADOS DEMONSTRATIVOS PARA PRÉVIA VISUAL (FRONT-END)
       ------------------------------------------------------------------------------
       O modelo atual (Produto.cs) e a base de dados ainda não possuem campos de marca,
       modelo detalhado, especificações técnicas e categorização por instrumento.
       Estes dados são demonstrativos e servem para validação da interface visual,
       respeitando o layout profissional e os mockups do projeto.
       ============================================================================== */

    var instrumentos = new[]
    {
        new {
            Nome = "Teclado Yamaha PSR-E373",
            Marca = "YAMAHA",
            Modelo = "PSR-E373",
            Preco = 2299.00m,
            ImagemUrl = Url.Content("~/img/teclado.png"),
            MaisVendido = true
        },
        new {
            Nome = "Teclado Casio CT-S300",
            Marca = "CASIO",
            Modelo = "CT-S300",
            Preco = 1299.00m,
            ImagemUrl = Url.Content("~/img/teclado.png"),
            MaisVendido = false
        },
        new {
            Nome = "Teclado Roland GO:KEYS 3",
            Marca = "ROLAND",
            Modelo = "GO:KEYS 3",
            Preco = 3799.00m,
            ImagemUrl = Url.Content("~/img/teclado.png"),
            MaisVendido = false
        },
        new {
            Nome = "Teclado Korg EK-50",
            Marca = "KORG",
            Modelo = "EK-50",
            Preco = 2499.00m,
            ImagemUrl = Url.Content("~/img/teclado.png"),
            MaisVendido = false
        },
        new {
            Nome = "Teclado Yamaha PSR-SX600",
            Marca = "YAMAHA",
            Modelo = "PSR-SX600",
            Preco = 5499.00m,
            ImagemUrl = Url.Content("~/img/teclado.png"),
            MaisVendido = false
        },
        new {
            Nome = "Teclado Casio CT-X700",
            Marca = "CASIO",
            Modelo = "CT-X700",
            Preco = 1899.00m,
            ImagemUrl = Url.Content("~/img/teclado.png"),
            MaisVendido = false
        },
        new {
            Nome = "Teclado Roland XPS-30",
            Marca = "ROLAND",
            Modelo = "XPS-30",
            Preco = 4899.00m,
            ImagemUrl = Url.Content("~/img/teclado.png"),
            MaisVendido = false
        },
        new {
            Nome = "Controlador MIDI Alesis V49",
            Marca = "ALESIS",
            Modelo = "V49",
            Preco = 1199.00m,
            ImagemUrl = Url.Content("~/img/teclado.png"),
            MaisVendido = false
        }
    };

    var marcas = new[] { "Yamaha", "Casio", "Roland", "Korg", "Alesis", "Outras" };
    var tipos = new[] { "Teclado portátil", "Piano digital", "Workstation", "Controlador MIDI", "Órgão" };
}

@section Styles {
    <link rel="stylesheet" href="~/css/categorias.css" asp-append-version="true" />
}

<div class="categoria-page">
    <!-- CABEÇALHO -->
    <header class="categoria-header">
        <a asp-controller="Home" asp-action="Index" class="categoria-voltar">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            Voltar para produtos
        </a>

        <div class="categoria-header-main">
            <div class="categoria-titulo-bloco">
                <h1 class="categoria-titulo">Teclados</h1>
                <p class="categoria-descricao">Som, tecnologia e versatilidade para todas as suas composições.</p>
            </div>

            <!-- Ilustração Neon em SVG -->
            <div class="categoria-neon-art" aria-hidden="true">
                <svg viewBox="0 0 220 90" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <!-- Contorno do sintetizador em perspectiva -->
                    <path d="M15 25 L165 15 L185 65 L25 80 Z" stroke="#c084fc" stroke-width="2.5" stroke-linejoin="round" />
                    <!-- Painel superior de controles -->
                    <path d="M22 28 L160 19 L165 35 L26 44 Z" stroke="#a855f7" stroke-width="1.5" />
                    <!-- Teclas brancas -->
                    <path d="M28 47 L167 37 L181 63 L34 76 Z" stroke="#c084fc" stroke-width="1.8" />
                    <line x1="45" y1="46" x2="52" y2="74" stroke="#c084fc" stroke-width="1.5" />
                    <line x1="60" y1="44" x2="68" y2="72" stroke="#c084fc" stroke-width="1.5" />
                    <line x1="75" y1="43" x2="84" y2="70" stroke="#c084fc" stroke-width="1.5" />
                    <line x1="90" y1="41" x2="100" y2="68" stroke="#c084fc" stroke-width="1.5" />
                    <line x1="105" y1="40" x2="116" y2="67" stroke="#c084fc" stroke-width="1.5" />
                    <line x1="120" y1="39" x2="132" y2="65" stroke="#c084fc" stroke-width="1.5" />
                    <line x1="135" y1="38" x2="148" y2="64" stroke="#c084fc" stroke-width="1.5" />
                    <line x1="150" y1="37" x2="164" y2="63" stroke="#c084fc" stroke-width="1.5" />
                    <!-- Teclas pretas -->
                    <path d="M37 46 L41 46 L45 61 L41 61 Z" fill="#9333ea" />
                    <path d="M52 45 L56 45 L61 60 L57 60 Z" fill="#9333ea" />
                    <path d="M82 42 L86 42 L92 57 L88 57 Z" fill="#9333ea" />
                    <path d="M97 41 L101 41 L108 56 L104 56 Z" fill="#9333ea" />
                    <path d="M112 40 L116 40 L124 55 L120 55 Z" fill="#9333ea" />
                    <path d="M142 38 L146 38 L154 53 L150 53 Z" fill="#9333ea" />
                    <!-- Notas musicais brilhantes -->
                    <path d="M185 20 Q195 10 205 22 L205 40 M195 15 L195 44" stroke="#e9d5ff" stroke-width="2" stroke-linecap="round" />
                    <ellipse cx="191" cy="44" rx="4" ry="3" fill="#e9d5ff" transform="rotate(-20 191 44)" />
                    <ellipse cx="201" cy="40" rx="4" ry="3" fill="#e9d5ff" transform="rotate(-20 201 40)" />
                    <path d="M175 48 Q182 42 186 50 L186 62" stroke="#a855f7" stroke-width="1.6" stroke-linecap="round" />
                    <ellipse cx="183" cy="62" rx="3.5" ry="2.5" fill="#a855f7" transform="rotate(-20 183 62)" />
                </svg>
            </div>
        </div>

        <div class="categoria-divider"></div>
    </header>

    <!-- BARRA DE ORDENAÇÃO -->
    <div class="categoria-toolbar">
        <label for="ordenarPor" class="toolbar-label">Ordenar por:</label>
        <div class="select-ordenar-wrapper">
            <select id="ordenarPor" class="select-ordenar" aria-label="Ordenar produtos">
                <option value="populares" selected>Mais populares</option>
                <option value="menor-preco">Menor preço</option>
                <option value="maior-preco">Maior preço</option>
                <option value="recentes">Mais recentes</option>
                <option value="avaliados">Mais avaliados</option>
            </select>
        </div>
    </div>

    <!-- CORPO PRINCIPAL: FILTROS + GRADE -->
    <div class="categoria-layout">
        <!-- PAINEL LATERAL DE FILTROS -->
        <aside class="categoria-sidebar" aria-label="Filtros de produtos">
            <div class="filtro-titulo-principal">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="4" y1="21" x2="4" y2="14"></line>
                    <line x1="4" y1="10" x2="4" y2="3"></line>
                    <line x1="12" y1="21" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12" y2="3"></line>
                    <line x1="20" y1="21" x2="20" y2="16"></line>
                    <line x1="20" y1="12" x2="20" y2="3"></line>
                    <line x1="1" y1="14" x2="7" y2="14"></line>
                    <line x1="9" y1="8" x2="15" y2="8"></line>
                    <line x1="17" y1="16" x2="23" y2="16"></line>
                </svg>
                <span>Filtrar</span>
            </div>

            <!-- Filtro de Marca -->
            <div class="filtro-secao">
                <div class="filtro-secao-header">
                    <span>Marca</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="18 15 12 9 6 15"></polyline>
                    </svg>
                </div>
                <ul class="filtro-lista">
                    @foreach (var marca in marcas)
                    {
                        <li>
                            <label class="filtro-item">
                                <input type="checkbox" name="marca" value="@marca" class="filtro-checkbox" />
                                <span>@marca</span>
                            </label>
                        </li>
                    }
                </ul>
            </div>

            <!-- Filtro de Tipo -->
            <div class="filtro-secao">
                <div class="filtro-secao-header">
                    <span>Tipo</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="18 15 12 9 6 15"></polyline>
                    </svg>
                </div>
                <ul class="filtro-lista">
                    @foreach (var tipo in tipos)
                    {
                        <li>
                            <label class="filtro-item">
                                <input type="checkbox" name="tipo" value="@tipo" class="filtro-checkbox" />
                                <span>@tipo</span>
                            </label>
                        </li>
                    }
                </ul>
            </div>

            <!-- Filtro de Faixa de Preço -->
            <div class="filtro-secao">
                <div class="filtro-secao-header">
                    <span>Faixa de preço</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </div>
                <div class="filtro-preco-box">
                    <input type="range" min="300" max="8000" value="4500" class="preco-slider-range" aria-label="Faixa de preço" />
                    <div class="preco-valores">
                        <span>R$ 300</span>
                        <span>R$ 8.000+</span>
                    </div>
                </div>
            </div>
        </aside>

        <!-- GRADE DE PRODUTOS -->
        <main class="categoria-produtos-grid" role="region" aria-label="Lista de Teclados">
            @foreach (var produto in instrumentos)
            {
                <article class="instrumento-card">
                    @if (produto.MaisVendido)
                    {
                        <span class="instrumento-badge">Mais vendido</span>
                    }

                    <div class="instrumento-img-area">
                        <img src="@produto.ImagemUrl" alt="@produto.Nome" class="instrumento-img" loading="lazy" />
                    </div>

                    <div class="instrumento-info">
                        <h2 class="instrumento-nome" title="@produto.Nome">@produto.Nome</h2>
                        <span class="instrumento-marca">@produto.Marca</span>
                        <div class="instrumento-preco">R$ @produto.Preco.ToString("N2", new System.Globalization.CultureInfo("pt-BR"))</div>

                        <button type="button" class="btn-carrinho" title="Adicionar ao carrinho">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="9" cy="21" r="1"></circle>
                                <circle cx="20" cy="21" r="1"></circle>
                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                            </svg>
                            <span>Adicionar ao carrinho</span>
                        </button>
                    </div>
                </article>
            }
        </main>
    </div>
</div>
