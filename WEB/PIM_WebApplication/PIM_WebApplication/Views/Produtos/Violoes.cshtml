@{
    ViewData["Title"] = "Violões - Loja de Música";

    /* ==============================================================================
       DADOS DEMONSTRATIVOS PARA PRÉVIA VISUAL (FRONT-END)
       ------------------------------------------------------------------------------
       O modelo atual (Produto.cs) e a base de dados ainda não possuem campos de marca,
       modelo detalhado, especificações técnicas e categorização por instrumento.
       Estes dados são demonstrativos e servem para validação da interface visual,
       respeitando o layout profissional e os mockups do projeto.
       ============================================================================== */

    var instrumentos = new[]
    {
        new {
            Nome = "Violão Eletroacústico Yamaha APX600",
            Marca = "YAMAHA",
            Modelo = "APX600",
            Preco = 2499.00m,
            ImagemUrl = Url.Content("~/img/Viola~o neon roxo.png"),
            MaisVendido = true
        },
        new {
            Nome = "Violão Tagima Dallas Aço Eletroacústico",
            Marca = "TAGIMA",
            Modelo = "Dallas Cutaway",
            Preco = 899.00m,
            ImagemUrl = Url.Content("~/img/Viola~o neon roxo.png"),
            MaisVendido = false
        },
        new {
            Nome = "Violão Takamine GD11MCE Folk Natural",
            Marca = "TAKAMINE",
            Modelo = "GD11MCE",
            Preco = 2799.00m,
            ImagemUrl = Url.Content("~/img/Viola~o neon roxo.png"),
            MaisVendido = false
        },
        new {
            Nome = "Violão Giannini Start N-14 Nylon",
            Marca = "GIANNINI",
            Modelo = "Start N-14",
            Preco = 429.00m,
            ImagemUrl = Url.Content("~/img/Viola~o neon roxo.png"),
            MaisVendido = false
        },
        new {
            Nome = "Violão Yamaha C40M Clássico Nylon",
            Marca = "YAMAHA",
            Modelo = "C40M",
            Preco = 749.00m,
            ImagemUrl = Url.Content("~/img/Viola~o neon roxo.png"),
            MaisVendido = false
        },
        new {
            Nome = "Violão Fender FA-125CE Dreadnought",
            Marca = "FENDER",
            Modelo = "FA-125CE",
            Preco = 1899.00m,
            ImagemUrl = Url.Content("~/img/Viola~o neon roxo.png"),
            MaisVendido = false
        },
        new {
            Nome = "Violão Di Giorgio Tarrega Nylon Clássico",
            Marca = "DI GIORGIO",
            Modelo = "Tarrega",
            Preco = 1599.00m,
            ImagemUrl = Url.Content("~/img/Viola~o neon roxo.png"),
            MaisVendido = false
        },
        new {
            Nome = "Violão Takamine 12 Cordas GD30CE-12 Folk",
            Marca = "TAKAMINE",
            Modelo = "GD30CE-12",
            Preco = 4199.00m,
            ImagemUrl = Url.Content("~/img/Viola~o neon roxo.png"),
            MaisVendido = false
        }
    };

    var marcas = new[] { "Giannini", "Yamaha", "Takamine", "Tagima", "Fender", "Di Giorgio", "Outras" };
    var tipos = new[] { "Clássico (Nylon)", "Folk (Aço)", "Eletroacústico", "12 Cordas", "Flat / Cutaway" };
}

@section Styles {
    <link rel="stylesheet" href="~/css/categorias.css" asp-append-version="true" />
}

<div class="categoria-page">
    <!-- CABEÇALHO -->
    <header class="categoria-header">
        <a asp-controller="Home" asp-action="Index" class="categoria-voltar">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            Voltar para produtos
        </a>

        <div class="categoria-header-main">
            <div class="categoria-titulo-bloco">
                <h1 class="categoria-titulo">Violões</h1>
                <p class="categoria-descricao">Acústica, harmonia e sonoridade pura para todas as suas canções.</p>
            </div>

            <!-- Ilustração Neon em SVG: Violão Acústico e Notas -->
            <div class="categoria-neon-art" aria-hidden="true">
                <svg viewBox="0 0 220 90" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <!-- Corpo do violão inclinado -->
                    <path d="M110 32 C125 15, 150 20, 155 40 C158 52, 148 60, 142 66 C155 72, 160 82, 145 88 C130 92, 110 82, 105 68 C102 58, 106 50, 110 32 Z"
                          stroke="#c084fc" stroke-width="2.2" stroke-linejoin="round" />
                    <!-- Boca do violão -->
                    <circle cx="128" cy="46" r="9" stroke="#a855f7" stroke-width="1.8" />
                    <circle cx="128" cy="46" r="6" stroke="#c084fc" stroke-width="1" stroke-dasharray="2 2" />
                    <!-- Cavalete -->
                    <rect x="122" y="66" width="16" height="4" rx="2" stroke="#c084fc" stroke-width="1.5" />
                    <!-- Braço do violão -->
                    <line x1="112" y1="33" x2="65" y2="12" stroke="#c084fc" stroke-width="4" stroke-linecap="round" />
                    <!-- Trastes -->
                    <line x1="102" y1="28" x2="100" y2="33" stroke="#a855f7" stroke-width="1.2" />
                    <line x1="92" y1="24" x2="90" y2="29" stroke="#a855f7" stroke-width="1.2" />
                    <line x1="82" y1="19" x2="80" y2="24" stroke="#a855f7" stroke-width="1.2" />
                    <line x1="72" y1="15" x2="70" y2="20" stroke="#a855f7" stroke-width="1.2" />
                    <!-- Mão / Headstock -->
                    <path d="M65 12 L48 5 L44 14 L61 21 Z" stroke="#c084fc" stroke-width="1.8" />
                    <!-- Tarraxas -->
                    <circle cx="52" cy="7" r="1.5" fill="#e9d5ff" />
                    <circle cx="58" cy="10" r="1.5" fill="#e9d5ff" />
                    <circle cx="48" cy="15" r="1.5" fill="#e9d5ff" />
                    <circle cx="54" cy="18" r="1.5" fill="#e9d5ff" />

                    <!-- Notas musicais flutuando -->
                    <path d="M178 18 Q188 8 198 18 L198 34" stroke="#e9d5ff" stroke-width="1.8" stroke-linecap="round" />
                    <ellipse cx="192" cy="34" rx="3.5" ry="2.5" fill="#e9d5ff" transform="rotate(-20 192 34)" />
                    <path d="M172 44 Q180 38 184 46 L184 56" stroke="#a855f7" stroke-width="1.5" stroke-linecap="round" />
                    <ellipse cx="180" cy="56" rx="3" ry="2" fill="#a855f7" transform="rotate(-20 180 56)" />
                </svg>
            </div>
        </div>

        <div class="categoria-divider"></div>
    </header>

    <!-- BARRA DE ORDENAÇÃO -->
    <div class="categoria-toolbar">
        <label for="ordenarPor" class="toolbar-label">Ordenar por:</label>
        <div class="select-ordenar-wrapper">
            <select id="ordenarPor" class="select-ordenar" aria-label="Ordenar produtos">
                <option value="populares" selected>Mais populares</option>
                <option value="menor-preco">Menor preço</option>
                <option value="maior-preco">Maior preço</option>
                <option value="recentes">Mais recentes</option>
                <option value="avaliados">Mais avaliados</option>
            </select>
        </div>
    </div>

    <!-- CORPO PRINCIPAL: FILTROS + GRADE -->
    <div class="categoria-layout">
        <!-- PAINEL LATERAL DE FILTROS -->
        <aside class="categoria-sidebar" aria-label="Filtros de produtos">
            <div class="filtro-titulo-principal">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="4" y1="21" x2="4" y2="14"></line>
                    <line x1="4" y1="10" x2="4" y2="3"></line>
                    <line x1="12" y1="21" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12" y2="3"></line>
                    <line x1="20" y1="21" x2="20" y2="16"></line>
                    <line x1="20" y1="12" x2="20" y2="3"></line>
                    <line x1="1" y1="14" x2="7" y2="14"></line>
                    <line x1="9" y1="8" x2="15" y2="8"></line>
                    <line x1="17" y1="16" x2="23" y2="16"></line>
                </svg>
                <span>Filtrar</span>
            </div>

            <!-- Filtro de Marca -->
            <div class="filtro-secao">
                <div class="filtro-secao-header">
                    <span>Marca</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="18 15 12 9 6 15"></polyline>
                    </svg>
                </div>
                <ul class="filtro-lista">
                    @foreach (var marca in marcas)
                    {
                        <li>
                            <label class="filtro-item">
                                <input type="checkbox" name="marca" value="@marca" class="filtro-checkbox" />
                                <span>@marca</span>
                            </label>
                        </li>
                    }
                </ul>
            </div>

            <!-- Filtro de Tipo -->
            <div class="filtro-secao">
                <div class="filtro-secao-header">
                    <span>Tipo</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="18 15 12 9 6 15"></polyline>
                    </svg>
                </div>
                <ul class="filtro-lista">
                    @foreach (var tipo in tipos)
                    {
                        <li>
                            <label class="filtro-item">
                                <input type="checkbox" name="tipo" value="@tipo" class="filtro-checkbox" />
                                <span>@tipo</span>
                            </label>
                        </li>
                    }
                </ul>
            </div>

            <!-- Filtro de Faixa de Preço -->
            <div class="filtro-secao">
                <div class="filtro-secao-header">
                    <span>Faixa de preço</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </div>
                <div class="filtro-preco-box">
                    <input type="range" min="300" max="10000" value="3500" class="preco-slider-range" aria-label="Faixa de preço" />
                    <div class="preco-valores">
                        <span>R$ 300</span>
                        <span>R$ 10.000+</span>
                    </div>
                </div>
            </div>
        </aside>

        <!-- GRADE DE PRODUTOS -->
        <main class="categoria-produtos-grid" role="region" aria-label="Lista de Violões">
            @foreach (var produto in instrumentos)
            {
                <article class="instrumento-card">
                    @if (produto.MaisVendido)
                    {
                        <span class="instrumento-badge">Mais vendido</span>
                    }

                    <div class="instrumento-img-area">
                        <img src="@produto.ImagemUrl" alt="@produto.Nome" class="instrumento-img" loading="lazy" />
                    </div>

                    <div class="instrumento-info">
                        <h2 class="instrumento-nome" title="@produto.Nome">@produto.Nome</h2>
                        <span class="instrumento-marca">@produto.Marca</span>
                        <div class="instrumento-preco">R$ @produto.Preco.ToString("N2", new System.Globalization.CultureInfo("pt-BR"))</div>

                        <button type="button" class="btn-carrinho" title="Adicionar ao carrinho">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="9" cy="21" r="1"></circle>
                                <circle cx="20" cy="21" r="1"></circle>
                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                            </svg>
                            <span>Adicionar ao carrinho</span>
                        </button>
                    </div>
                </article>
            }
        </main>
    </div>
</div>
