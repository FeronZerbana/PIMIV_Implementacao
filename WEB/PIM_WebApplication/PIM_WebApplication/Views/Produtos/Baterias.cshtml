@model IEnumerable<PIM_WebApplication.Models.Produto>
@{
    ViewData["Title"] = "Baterias - Loja de Música";
    var fallbackCategoria = Url.Content("~/img/bateria.jpeg");
    var ordemAtual = ViewData["OrdemAtual"]?.ToString() ?? "populares";
}

@section Styles {
    <link rel="stylesheet" href="~/css/categorias.css" asp-append-version="true" />
}

<div class="categoria-page">
    <!-- CABEÇALHO -->
    <header class="categoria-header">
        <a asp-controller="Home" asp-action="Index" class="categoria-voltar">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            Voltar para produtos
        </a>

        <div class="categoria-header-main">
            <div class="categoria-titulo-bloco">
                <h1 class="categoria-titulo">Baterias</h1>
                <p class="categoria-descricao">Ritmo, potência e qualidade para o seu som.</p>
            </div>

            <!-- Ilustração Neon em SVG: Bateria e Baquetas -->
            <div class="categoria-neon-art" aria-hidden="true">
                <svg viewBox="0 0 220 90" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <!-- Par de Baquetas cruzadas à esquerda -->
                    <line x1="10" y1="20" x2="45" y2="70" stroke="#c084fc" stroke-width="2.5" stroke-linecap="round" />
                    <line x1="18" y1="16" x2="53" y2="66" stroke="#a855f7" stroke-width="2.5" stroke-linecap="round" />
                    <circle cx="10" cy="20" r="2.5" fill="#e9d5ff" />
                    <circle cx="18" cy="16" r="2.5" fill="#e9d5ff" />

                    <!-- Bumbo central -->
                    <circle cx="115" cy="55" r="25" stroke="#c084fc" stroke-width="2.2" />
                    <circle cx="115" cy="55" r="21" stroke="#a855f7" stroke-width="1.2" stroke-dasharray="3 3" />
                    <!-- Pés do bumbo -->
                    <line x1="95" y1="70" x2="88" y2="82" stroke="#c084fc" stroke-width="2" stroke-linecap="round" />
                    <line x1="135" y1="70" x2="142" y2="82" stroke="#c084fc" stroke-width="2" stroke-linecap="round" />

                    <!-- Tom 1 e Tom 2 -->
                    <ellipse cx="102" cy="24" rx="11" ry="6" stroke="#c084fc" stroke-width="1.8" />
                    <line x1="91" y1="24" x2="91" y2="33" stroke="#c084fc" stroke-width="1.6" />
                    <line x1="113" y1="24" x2="113" y2="33" stroke="#c084fc" stroke-width="1.6" />
                    <path d="M91 33 Q102 39 113 33" stroke="#c084fc" stroke-width="1.6" />

                    <ellipse cx="128" cy="24" rx="11" ry="6" stroke="#c084fc" stroke-width="1.8" />
                    <line x1="117" y1="24" x2="117" y2="33" stroke="#c084fc" stroke-width="1.6" />
                    <line x1="139" y1="24" x2="139" y2="33" stroke="#c084fc" stroke-width="1.6" />
                    <path d="M117 33 Q128 39 139 33" stroke="#c084fc" stroke-width="1.6" />

                    <!-- Prato Chimbal (esquerda) -->
                    <ellipse cx="72" cy="28" rx="14" ry="4" stroke="#c084fc" stroke-width="1.8" />
                    <line x1="72" y1="28" x2="72" y2="76" stroke="#a855f7" stroke-width="1.6" />
                    <path d="M60 76 L72 76 L84 76" stroke="#c084fc" stroke-width="1.5" />

                    <!-- Prato Condução / Ataque (direita) -->
                    <ellipse cx="158" cy="22" rx="15" ry="4" stroke="#c084fc" stroke-width="1.8" />
                    <line x1="158" y1="22" x2="158" y2="76" stroke="#a855f7" stroke-width="1.6" />
                    <path d="M148 76 L158 76 L168 76" stroke="#c084fc" stroke-width="1.5" />

                    <!-- Caixa (lado esquerdo do bumbo) -->
                    <ellipse cx="80" cy="48" rx="11" ry="5" stroke="#c084fc" stroke-width="1.8" />
                    <line x1="69" y1="48" x2="69" y2="56" stroke="#c084fc" stroke-width="1.5" />
                    <line x1="91" y1="48" x2="91" y2="56" stroke="#c084fc" stroke-width="1.5" />
                    <path d="M69 56 Q80 61 91 56" stroke="#c084fc" stroke-width="1.5" />
                    <line x1="80" y1="58" x2="80" y2="78" stroke="#a855f7" stroke-width="1.5" />

                    <!-- Notas Musicais flutuando à direita -->
                    <path d="M190 14 Q200 4 210 16 L210 34" stroke="#e9d5ff" stroke-width="2" stroke-linecap="round" />
                    <ellipse cx="204" cy="34" rx="4" ry="3" fill="#e9d5ff" transform="rotate(-20 204 34)" />
                    <path d="M182 36 Q190 30 194 38 L194 50" stroke="#a855f7" stroke-width="1.6" stroke-linecap="round" />
                    <ellipse cx="190" cy="50" rx="3.5" ry="2.5" fill="#a855f7" transform="rotate(-20 190 50)" />
                </svg>
            </div>
        </div>

        <div class="categoria-divider"></div>
    </header>

    <!-- BARRA DE ORDENAÇÃO -->
    <div class="categoria-toolbar">
        <label for="ordenarPor" class="toolbar-label">Ordenar por:</label>
        <div class="select-ordenar-wrapper">
            <select id="ordenarPor" class="select-ordenar" aria-label="Ordenar produtos" onchange="tratarAlteracaoOrdenacao(this.value)">
                <!option value="populares" @(ordemAtual == "populares" ? "selected" : "")>Mais populares</!option>
                <!option value="menor-preco" @(ordemAtual == "menor-preco" ? "selected" : "")>Menor preço</!option>
                <!option value="maior-preco" @(ordemAtual == "maior-preco" ? "selected" : "")>Maior preço</!option>
            </select>
        </div>
    </div>

    <!-- GRADE DE PRODUTOS EXPANSIVA (SEM FILTROS LATERAIS) -->
    <main class="categoria-produtos-grid" role="region" aria-label="Lista de Baterias">
        @if (Model != null && Model.Any())
        {
            @foreach (var produto in Model)
            {
                var imgFinal = !string.IsNullOrWhiteSpace(produto.ImagemUrl) ? produto.ImagemUrl : fallbackCategoria;
                var estoqueDisponivel = produto.Estoque?.QuantidadeDisponivel ?? 0;
                var temEstoque = estoqueDisponivel > 0;
                var descricaoProduto = !string.IsNullOrWhiteSpace(produto.Descricao) 
                    ? produto.Descricao 
                    : "Bateria acustica ou eletronica com cascos selecionados, ferragens reforcadas e alta projecao ritmica.";

                <article class="instrumento-card"
                         data-id="@produto.IdProduto"
                         data-nome="@produto.Modelo"
                         data-categoria="@produto.TipoInstrumento"
                         data-preco="@produto.Preco.ToString("N2", new System.Globalization.CultureInfo("pt-BR"))"
                         data-preco-raw="@produto.Preco.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                         data-descricao="@descricaoProduto"
                         data-estoque="@estoqueDisponivel"
                         data-imagem="@imgFinal"
                         onclick="abrirModalDetalhesPorCard(this, event)">

                    <div class="instrumento-img-area">
                        <img src="@imgFinal" alt="@produto.Modelo" class="instrumento-img" loading="lazy" onerror="this.onerror=null;this.src='@fallbackCategoria';" />
                    </div>

                    <div class="instrumento-info">
                        <h2 class="instrumento-nome" title="@produto.Modelo">@produto.Modelo</h2>
                        <span class="instrumento-marca">@produto.TipoInstrumento</span>
                        <div class="instrumento-preco">R$ @produto.Preco.ToString("N2", new System.Globalization.CultureInfo("pt-BR"))</div>

                        <form asp-controller="Carrinho" asp-action="Adicionar" method="post" style="display:inline;" onclick="event.stopPropagation();">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="idProduto" value="@produto.IdProduto" />
                            <input type="hidden" name="nome" value="@produto.TipoInstrumento" />
                            <input type="hidden" name="preco" value="@produto.Preco.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            <input type="hidden" name="modelo" value="@produto.Modelo" />
                            <input type="hidden" name="tamanho" value="@produto.Modelo" />
                            <input type="hidden" name="imagemUrl" value="@imgFinal" />
                            <button type="submit" class="btn-carrinho" title="Adicionar ao carrinho" @(!temEstoque ? "disabled style='opacity:0.5;cursor:not-allowed;'" : "")>
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="9" cy="21" r="1"></circle>
                                    <circle cx="20" cy="21" r="1"></circle>
                                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                </svg>
                                <span>@(temEstoque ? "Adicionar ao carrinho" : "Fora de estoque")</span>
                            </button>
                        </form>
                    </div>
                </article>
            }
        }
        else
        {
            <div style="grid-column: 1 / -1; text-align: center; padding: 4rem 1rem; color: var(--muted);">
                <p style="font-size: 1.1rem; margin-bottom: 0.5rem;">Nenhum produto cadastrado nesta categoria no momento.</p>
                <a asp-controller="Home" asp-action="Index" class="btn-hero" style="display:inline-block; margin-top:1rem;">Ver outras categorias</a>
            </div>
        }
    </main>
</div>
