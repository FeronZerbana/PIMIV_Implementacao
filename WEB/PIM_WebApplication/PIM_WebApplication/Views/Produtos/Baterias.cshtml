@{
    ViewData["Title"] = "Baterias - Loja de Música";

    /* ==============================================================================
       DADOS DEMONSTRATIVOS PARA PRÉVIA VISUAL (FRONT-END)
       ------------------------------------------------------------------------------
       O modelo atual (Produto.cs) e a base de dados ainda não possuem campos de marca,
       modelo detalhado, especificações técnicas e categorização por instrumento.
       Estes dados são demonstrativos e servem para validação da interface visual,
       respeitando o layout profissional e os mockups do projeto.
       ============================================================================== */

    var instrumentos = new[]
    {
        new {
            Nome = "Bateria Pearl Roadshow PT-504 (5 peças)",
            Marca = "PEARL",
            Modelo = "PT-504",
            Preco = 3499.00m,
            ImagemUrl = Url.Content("~/img/bateria.jpeg"),
            MaisVendido = true
        },
        new {
            Nome = "Bateria Yamaha Stage Custom 5 peças",
            Marca = "YAMAHA",
            Modelo = "Stage Custom",
            Preco = 4999.00m,
            ImagemUrl = Url.Content("~/img/bateria.jpeg"),
            MaisVendido = false
        },
        new {
            Nome = "Bateria Tama Imperialstar 5 peças",
            Marca = "TAMA",
            Modelo = "Imperialstar",
            Preco = 4299.00m,
            ImagemUrl = Url.Content("~/img/bateria.jpeg"),
            MaisVendido = false
        },
        new {
            Nome = "Bateria Pearl Export 5 peças",
            Marca = "PEARL",
            Modelo = "Export Series",
            Preco = 5499.00m,
            ImagemUrl = Url.Content("~/img/bateria.jpeg"),
            MaisVendido = false
        },
        new {
            Nome = "Bateria Eletrônica Yamaha DTX452K",
            Marca = "YAMAHA",
            Modelo = "DTX452K",
            Preco = 6999.00m,
            ImagemUrl = Url.Content("~/img/bateria.jpeg"),
            MaisVendido = false
        },
        new {
            Nome = "Bateria Ludwig Accent 5 peças",
            Marca = "LUDWIG",
            Modelo = "Accent",
            Preco = 5799.00m,
            ImagemUrl = Url.Content("~/img/bateria.jpeg"),
            MaisVendido = false
        },
        new {
            Nome = "Bateria Odery Fluence 5 peças",
            Marca = "ODERY",
            Modelo = "Fluence Fusion",
            Preco = 6499.00m,
            ImagemUrl = Url.Content("~/img/bateria.jpeg"),
            MaisVendido = false
        },
        new {
            Nome = "Bateria Infantil Yamaha Junior Kit",
            Marca = "YAMAHA",
            Modelo = "Junior Kit Manu Katché",
            Preco = 1899.00m,
            ImagemUrl = Url.Content("~/img/bateria.jpeg"),
            MaisVendido = false
        }
    };

    var marcas = new[] { "Pearl", "Yamaha", "Tama", "Ludwig", "Odery", "Mapex", "Outras" };
    var tipos = new[] { "Acústica", "Eletrônica", "Compacta (bateria infantil)", "Kit completo" };
}

@section Styles {
    <link rel="stylesheet" href="~/css/categorias.css" asp-append-version="true" />
}

<div class="categoria-page">
    <!-- CABEÇALHO -->
    <header class="categoria-header">
        <a asp-controller="Home" asp-action="Index" class="categoria-voltar">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            Voltar para produtos
        </a>

        <div class="categoria-header-main">
            <div class="categoria-titulo-bloco">
                <h1 class="categoria-titulo">Baterias</h1>
                <p class="categoria-descricao">Ritmo, potência e qualidade para o seu som.</p>
            </div>

            <!-- Ilustração Neon em SVG: Bateria e Baquetas -->
            <div class="categoria-neon-art" aria-hidden="true">
                <svg viewBox="0 0 220 90" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <!-- Par de Baquetas cruzadas à esquerda -->
                    <line x1="10" y1="20" x2="45" y2="70" stroke="#c084fc" stroke-width="2.5" stroke-linecap="round" />
                    <line x1="18" y1="16" x2="53" y2="66" stroke="#a855f7" stroke-width="2.5" stroke-linecap="round" />
                    <circle cx="10" cy="20" r="2.5" fill="#e9d5ff" />
                    <circle cx="18" cy="16" r="2.5" fill="#e9d5ff" />

                    <!-- Bumbo central -->
                    <circle cx="115" cy="55" r="25" stroke="#c084fc" stroke-width="2.2" />
                    <circle cx="115" cy="55" r="21" stroke="#a855f7" stroke-width="1.2" stroke-dasharray="3 3" />
                    <!-- Pés do bumbo -->
                    <line x1="95" y1="70" x2="88" y2="82" stroke="#c084fc" stroke-width="2" stroke-linecap="round" />
                    <line x1="135" y1="70" x2="142" y2="82" stroke="#c084fc" stroke-width="2" stroke-linecap="round" />

                    <!-- Tom 1 e Tom 2 -->
                    <ellipse cx="102" cy="24" rx="11" ry="6" stroke="#c084fc" stroke-width="1.8" />
                    <line x1="91" y1="24" x2="91" y2="33" stroke="#c084fc" stroke-width="1.6" />
                    <line x1="113" y1="24" x2="113" y2="33" stroke="#c084fc" stroke-width="1.6" />
                    <path d="M91 33 Q102 39 113 33" stroke="#c084fc" stroke-width="1.6" />

                    <ellipse cx="128" cy="24" rx="11" ry="6" stroke="#c084fc" stroke-width="1.8" />
                    <line x1="117" y1="24" x2="117" y2="33" stroke="#c084fc" stroke-width="1.6" />
                    <line x1="139" y1="24" x2="139" y2="33" stroke="#c084fc" stroke-width="1.6" />
                    <path d="M117 33 Q128 39 139 33" stroke="#c084fc" stroke-width="1.6" />

                    <!-- Prato Chimbal (esquerda) -->
                    <ellipse cx="72" cy="28" rx="14" ry="4" stroke="#c084fc" stroke-width="1.8" />
                    <line x1="72" y1="28" x2="72" y2="76" stroke="#a855f7" stroke-width="1.6" />
                    <line x1="65" y1="76" x2="79" y2="76" stroke="#a855f7" stroke-width="2" />

                    <!-- Prato de Condução / Ataque (direita) -->
                    <ellipse cx="158" cy="22" rx="16" ry="4" stroke="#c084fc" stroke-width="1.8" />
                    <line x1="158" y1="22" x2="158" y2="76" stroke="#a855f7" stroke-width="1.6" />
                    <line x1="151" y1="76" x2="165" y2="76" stroke="#a855f7" stroke-width="2" />

                    <!-- Notas musicais -->
                    <path d="M185 18 Q195 8 205 18 L205 34" stroke="#e9d5ff" stroke-width="1.8" stroke-linecap="round" />
                    <ellipse cx="199" cy="34" rx="3.5" ry="2.5" fill="#e9d5ff" transform="rotate(-20 199 34)" />
                    <path d="M180 44 Q188 38 192 46 L192 56" stroke="#a855f7" stroke-width="1.5" stroke-linecap="round" />
                    <ellipse cx="188" cy="56" rx="3" ry="2" fill="#a855f7" transform="rotate(-20 188 56)" />
                </svg>
            </div>
        </div>

        <div class="categoria-divider"></div>
    </header>

    <!-- BARRA DE ORDENAÇÃO -->
    <div class="categoria-toolbar">
        <label for="ordenarPor" class="toolbar-label">Ordenar por:</label>
        <div class="select-ordenar-wrapper">
            <select id="ordenarPor" class="select-ordenar" aria-label="Ordenar produtos">
                <option value="populares" selected>Mais populares</option>
                <option value="menor-preco">Menor preço</option>
                <option value="maior-preco">Maior preço</option>
                <option value="recentes">Mais recentes</option>
                <option value="avaliados">Mais avaliados</option>
            </select>
        </div>
    </div>

    <!-- CORPO PRINCIPAL: FILTROS + GRADE -->
    <div class="categoria-layout">
        <!-- PAINEL LATERAL DE FILTROS -->
        <aside class="categoria-sidebar" aria-label="Filtros de produtos">
            <div class="filtro-titulo-principal">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="4" y1="21" x2="4" y2="14"></line>
                    <line x1="4" y1="10" x2="4" y2="3"></line>
                    <line x1="12" y1="21" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12" y2="3"></line>
                    <line x1="20" y1="21" x2="20" y2="16"></line>
                    <line x1="20" y1="12" x2="20" y2="3"></line>
                    <line x1="1" y1="14" x2="7" y2="14"></line>
                    <line x1="9" y1="8" x2="15" y2="8"></line>
                    <line x1="17" y1="16" x2="23" y2="16"></line>
                </svg>
                <span>Filtrar</span>
            </div>

            <!-- Filtro de Marca -->
            <div class="filtro-secao">
                <div class="filtro-secao-header">
                    <span>Marca</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="18 15 12 9 6 15"></polyline>
                    </svg>
                </div>
                <ul class="filtro-lista">
                    @foreach (var marca in marcas)
                    {
                        <li>
                            <label class="filtro-item">
                                <input type="checkbox" name="marca" value="@marca" class="filtro-checkbox" />
                                <span>@marca</span>
                            </label>
                        </li>
                    }
                </ul>
            </div>

            <!-- Filtro de Tipo -->
            <div class="filtro-secao">
                <div class="filtro-secao-header">
                    <span>Tipo</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="18 15 12 9 6 15"></polyline>
                    </svg>
                </div>
                <ul class="filtro-lista">
                    @foreach (var tipo in tipos)
                    {
                        <li>
                            <label class="filtro-item">
                                <input type="checkbox" name="tipo" value="@tipo" class="filtro-checkbox" />
                                <span>@tipo</span>
                            </label>
                        </li>
                    }
                </ul>
            </div>

            <!-- Filtro de Faixa de Preço -->
            <div class="filtro-secao">
                <div class="filtro-secao-header">
                    <span>Faixa de preço</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </div>
                <div class="filtro-preco-box">
                    <input type="range" min="1000" max="15000" value="7000" class="preco-slider-range" aria-label="Faixa de preço" />
                    <div class="preco-valores">
                        <span>R$ 1.000</span>
                        <span>R$ 15.000+</span>
                    </div>
                </div>
            </div>
        </aside>

        <!-- GRADE DE PRODUTOS -->
        <main class="categoria-produtos-grid" role="region" aria-label="Lista de Baterias">
            @foreach (var produto in instrumentos)
            {
                <article class="instrumento-card">
                    @if (produto.MaisVendido)
                    {
                        <span class="instrumento-badge">Mais vendido</span>
                    }

                    <div class="instrumento-img-area">
                        <img src="@produto.ImagemUrl" alt="@produto.Nome" class="instrumento-img" loading="lazy" />
                    </div>

                    <div class="instrumento-info">
                        <h2 class="instrumento-nome" title="@produto.Nome">@produto.Nome</h2>
                        <span class="instrumento-marca">@produto.Marca</span>
                        <div class="instrumento-preco">R$ @produto.Preco.ToString("N2", new System.Globalization.CultureInfo("pt-BR"))</div>

                        <button type="button" class="btn-carrinho" title="Adicionar ao carrinho">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="9" cy="21" r="1"></circle>
                                <circle cx="20" cy="21" r="1"></circle>
                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                            </svg>
                            <span>Adicionar ao carrinho</span>
                        </button>
                    </div>
                </article>
            }
        </main>
    </div>
</div>
